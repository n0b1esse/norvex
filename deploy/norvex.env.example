# Template for the Directus env file on the VPS: /home/temur/envs/norvex.env
# Copy to that path (NOT into git), fill in real secrets, and `chmod 600` it.
# Generate secrets with:  openssl rand -hex 16   (KEY)   /   openssl rand -base64 32   (SECRET)

# --- Security keys (changing these invalidates sessions / cached data) ---
KEY=__random_hex__
SECRET=__random_base64__

# --- First admin user (created on first boot only) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=__strong_password__

# --- Database: SQLite file on a bind-mounted volume (note: client is "sqlite3") ---
DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db

# --- Public URL: served under a subpath behind traefik (StripPrefix middleware) ---
PUBLIC_URL=http://127.0.0.1:18055

# --- CORS: allow the Astro site to call the API from a browser.
#     Tighten CORS_ORIGIN to the real site origin once the domain is known. ---
CORS_ENABLED=true
CORS_ORIGIN=true

WEBSOCKETS_ENABLED=true
