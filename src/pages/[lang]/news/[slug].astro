---
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../../i18n";
import { api, asset } from "../../../lib/api";
import { NEWS } from "../../../data/news";

// Страницы статей генерируются из MySQL (новые новости из админки появляются сразу).
// Если API недоступен (сборка без сети) — используем локальный список.
export const getStaticPaths = async () => {
  const langs = ["ru", "en", "ky"] as const;
  const slugs = new Set<string>();

  for (const lang of langs) {
    try {
      const rows = await api<{ slug: string }[]>("news", { lang });
      rows.forEach((r) => r.slug && slugs.add(r.slug));
    } catch { /* API недоступен — ниже возьмём локальный список */ }
  }
  NEWS.forEach((n) => slugs.add(n.slug));

  return [...slugs].flatMap((slug) => langs.map((lang) => ({ params: { lang, slug } })));
};

const { lang, slug } = Astro.params as { lang: string; slug: string };
const t = await getT(lang);

type DbNews = {
  id?: number; slug: string; news_date?: string | null; category?: string | null;
  title: string; excerpt?: string | null; content?: string | null; image?: string | null;
};

let dbItem: DbNews | null = null;
try {
  const rows = await api<DbNews[]>("news_one", { lang, slug });
  dbItem = rows && !Array.isArray(rows) ? rows : null;
} catch { /* fallback ниже */ }

const localItem = NEWS.find((n) => n.slug === slug);

const newsItem = dbItem
  ? {
      slug: dbItem.slug,
      date: dbItem.news_date || "",
      category: dbItem.category || "",
      title: dbItem.title,
      excerpt: dbItem.excerpt || "",
      content: dbItem.content || "",
      image: asset(dbItem.image) ?? null,
    }
  : localItem
    ? {
        slug: localItem.slug,
        date: localItem.date,
        category: localItem.category,
        title: localItem.title[lang] ?? localItem.title.ru,
        excerpt: localItem.excerpt[lang] ?? localItem.excerpt.ru,
        content: localItem.content[lang] ?? localItem.content.ru,
        image: localItem.image ?? null,
      }
    : null;

if (!newsItem) {
  return new Response(null, { status: 404 });
}

const categoryLabel = {
  ru: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
  en: { "Законодательство": "Legislation", "Компания": "Company", "Экспертиза": "Expertise", "События": "Events" },
  ky: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
}[lang];

const formatDate = (iso: string) => {
  const d = new Date(iso);
  const opts: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
  return lang === "ky" ? d.toLocaleDateString("ky-KG", opts) : d.toLocaleDateString(lang === "en" ? "en-US" : "ru-RU", opts);
};
---
<Layout lang={lang} title={newsItem.title} description={newsItem.excerpt} livePage={"news"}>
  <section class="page-hero">
    {newsItem.image ? (
      <img class="hero-bg" src={newsItem.image} alt="" aria-hidden="true" />
    ) : null}
    <div class="container">
      <div class="hero-text">
        <span class="news-detail-category">{categoryLabel[newsItem.category]}</span>
        <h1>{newsItem.title}</h1>
        <p class="news-detail-date">{formatDate(newsItem.date)}</p>
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer">
    <div class="container">
      <article class="news-detail" set:html={newsItem.content || ""}></article>
      <div class="news-detail-back">
        <a href={lp(lang, "/news")} class="btn btn-outline-green" data-back-link data-back-alt={t("cta.back")}>
          <Icon name="arrow-left" size={18} /> <span data-c="global.cta.back_news">{t("cta.back_news")}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .news-detail-category { display: inline-block; background: #e5f4ea; color: var(--green-700); font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 12px; }
  .news-detail-date { color: var(--muted); font-size: 15px; margin-top: 6px; }
  .news-detail { font-size: calc(16px * var(--ts-body)); line-height: 1.8; color: var(--ink); margin-bottom: 32px; }
  .news-detail p { margin-bottom: 18px; }
  .news-detail ul, .news-detail ol { margin: 12px 0 18px 24px; padding-left: 18px; }
  .news-detail li { margin-bottom: 8px; color: var(--ink); }
  .news-detail strong { color: var(--navy); }
  .news-detail-back { margin-top: 32px; }
  .news-detail-back .btn { width: auto; }
</style>

<script>
  // Кнопка "Назад" ведёт туда, откуда пришли.
  // По умолчанию (без JS / внешний переход) — страница /news.
  // Если пользователь пришёл с другой страницы сайта (например, с главной),
  // ссылка меняется на неё, а подпись — на "Назад".
  // Ждём live-оверлей (он перезаписывает data-c слоты), иначе подпись слетит обратно.
  const apply = () => {
    const back = document.querySelector<HTMLAnchorElement>("[data-back-link]");
    if (!back || !document.referrer) return;
    try {
      const ref = new URL(document.referrer);
      if (ref.origin === location.origin && !/\/news(\/|$)/.test(ref.pathname)) {
        back.setAttribute("href", ref.pathname + ref.search + ref.hash);
        const label = back.querySelector("span");
        const alt = back.getAttribute("data-back-alt");
        if (label && alt) label.textContent = alt;
      }
    } catch { /* referrer unparsable — keep default */ }
  };
  const liveW = window as unknown as { __liveTexts?: unknown };
  if (liveW.__liveTexts) apply();
  else {
    window.addEventListener("live:content", apply, { once: true });
    setTimeout(apply, 1500);
  }
</script>
