---
import Layout from "../../layouts/Layout.astro";
import teamFounder from "../../assets/team-founder.jpg";
import { getT, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Жёстко заданные данные команды (без зависимости от Directus — работает без CMS)
const LEADERS = 2;
const team = [
  { name: "Абдраимов Тумарбек Абдраимович", position: "Учредитель", experience: "10 лет", photo: teamFounder },
  { name: "Оморкулов Уланбек Абдраимович", position: "Директор", experience: "15 лет", photo: null as unknown as typeof teamFounder },
  { name: "Маматов Данияр Талгатович", position: "Эксперт по пожарной безопасности", experience: "10 лет", photo: null as unknown as typeof teamFounder },
  { name: "Сидякова Айгуль Нурлановна", position: "Эксперт по охране окружающей среды (Экология)", experience: "9 лет", photo: null as unknown as typeof teamFounder },
  { name: "Козлов Алексей Сергеевич", position: "Инженер по охране труда", experience: "7 лет", photo: null as unknown as typeof teamFounder },
  { name: "Петрова Мария Ивановна", position: "Эколог", experience: "5 лет", photo: null as unknown as typeof teamFounder },
];

const leaders = team.slice(0, LEADERS);
const specialists = team.slice(LEADERS);
const hasMore = specialists.length > 0;
// Монограмма «Фамилия Имя» для карточек без загруженного фото
const initials = (name: string) =>
  name.trim().split(/\s+/).slice(0, 2).map((w) => [...w][0]?.toUpperCase() ?? "").join("");
---
<Layout lang={lang} title={t("seo.team.title")} description={t("seo.team.desc")}>
  <section class="section">
    <div class="container">
      <div class="section-head left">
        <h1 class="section-title">{t("page.team_title")}</h1>
        <p class="section-lead">{t("page.team_lead")}</p>
      </div>

      {/* Группа 1: директор + учредитель — первая строка, горизонтальные карточки (2 в ряд) */}
      <div class="grid grid-2 team-grid leaders-grid">
        {leaders.map((m) => (
          <article class="member leader">
            <div class="photo">
              {m.photo
                ? <img src={m.photo.src} alt={m.name} width={800} height={800} />
                : <span class="monogram" aria-hidden="true">{initials(m.name)}</span>}
            </div>
            <div class="member-body">
              <h3>{m.name}</h3>
              <p class="role">{m.position}</p>
              <div class="exp"><span class="exp-label">{t("team.experience")}</span><span class="exp-value">{m.experience}</span></div>
            </div>
          </article>
        ))}
      </div>

      {/* Группа 2: остальные специалисты — скрыты до нажатия «Все специалисты» */}
      {hasMore && (
        <>
          <div class="team-cta">
            <button type="button" class="btn btn-primary" data-show-all>{t("cta.all_specialists")}</button>
          </div>

          <div class:list={["specialists-block", { hidden: true }]}>
            <div class="section-head-specialists">
              <h2>{t("team.key_instructors")}</h2>
              <span class="bar" aria-hidden="true"></span>
            </div>
            <div class="grid grid-4 team-grid specialists-grid">
              {specialists.map((m) => (
                <article class:list={["member", { "is-hidden": true }]}>
                  <div class="photo">
                    {m.photo
                      ? <img src={m.photo.src} alt={m.name} width={800} height={800} loading="lazy" />
                      : <span class="monogram" aria-hidden="true">{initials(m.name)}</span>}
                  </div>
                  <div class="member-body">
                    <h3>{m.name}</h3>
                    <p class="role">{m.position}</p>
                    <div class="exp"><span class="exp-label">{t("team.experience")}</span><span class="exp-value">{m.experience}</span></div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </>
      )}
    </div>
  </section>
</Layout>

<style>
  .team-grid { margin-top: 8px; gap: 22px; }

  /* Карточки — в языке .card из global.css: белая поверхность, волосяная рамка,
     мягкая тень, подъём и зелёная рамка при наведении. */
  .member {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: translate .22s ease, box-shadow .22s ease, border-color .22s ease;
  }
  .member:hover {
    translate: 0 -4px;
    box-shadow: var(--shadow);
    border-color: rgba(42,165,74,.35);
  }

  /* Фото: квадратный кроп с фокусом на лице; без фото — монограмма на мягком градиенте */
  .photo {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(155deg, #eef2f7 0%, #dde6ee 100%);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 16%;
    border: 0;
    display: block;
  }
  .monogram {
    font-size: 46px;
    font-weight: 800;
    letter-spacing: .05em;
    color: rgba(16, 50, 87, .35);
    user-select: none;
  }

  .member-body { padding: 18px 20px 18px; display: flex; flex-direction: column; flex: 1; }
  .member-body h3 {
    font-size: calc(16px * var(--ts-heading));
    font-weight: 800;
    line-height: 1.34;
    color: var(--navy);
    margin: 0 0 6px;
  }
  .role { color: var(--muted); font-size: 13px; line-height: 1.45; margin: 0; }

  /* Стаж — волосяная линия, справа значение зелёным (как в ранней версии карточек) */
  .exp {
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .exp-label {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .exp-value { color: var(--green-700); font-weight: 800; font-size: 14px; white-space: nowrap; }

  /* Лидеры — горизонтальные карточки: фото слева, текст справа, без гигантского кропа */
  .member.leader { flex-direction: row; align-items: stretch; }
  .member.leader .photo { flex: 0 0 42%; aspect-ratio: auto; min-height: 230px; }
  .member.leader .monogram { font-size: 64px; }
  .member.leader .member-body { padding: 22px 24px; justify-content: center; }
  .member.leader .member-body h3 { font-size: calc(19px * var(--ts-heading)); margin-bottom: 8px; }
  .member.leader .role { font-size: 14px; margin-bottom: 18px; }

  /* Заголовок второй группы — с короткой зелёной чертой, как в .section-head */
  .section-head-specialists { margin: 48px 0 24px 0; text-align: left; }
  .section-head-specialists h2 {
    color: var(--navy);
    font-size: calc(21px * var(--ts-heading));
    font-weight: 800;
    margin: 0;
  }
  .section-head-specialists .bar {
    display: block;
    width: 44px;
    height: 4px;
    border-radius: 4px;
    background: var(--green-500);
    margin-top: 10px;
  }

  .team-cta { display: flex; justify-content: center; margin: 40px 0 24px 0; }

  .specialists-block.hidden { display: none; }
  .member.is-hidden { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .member { transition: none; }
    .member:hover { translate: none; }
  }
  @media (max-width: 560px) {
    .member.leader { flex-direction: column; }
    .member.leader .photo { flex-basis: auto; aspect-ratio: 1 / 1; min-height: 0; }
  }
</style>

<script>
  // FLIP reveal второй группы специалистов.
  const btn = document.querySelector<HTMLElement>("[data-show-all]");
  const block = document.querySelector<HTMLElement>(".specialists-block");
  const grid = document.querySelector<HTMLElement>(".specialists-grid");
  const REDUCE = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DUR = 500;
  btn?.addEventListener("click", () => {
    if (!block || !grid) return;
    const hidden = Array.from(grid.querySelectorAll<HTMLElement>(".member.is-hidden"));

    // Reduced motion (or nothing to reveal): show them with no animation.
    if (REDUCE || !hidden.length) {
      block.classList.remove("hidden");
      hidden.forEach((el) => el.classList.remove("is-hidden"));
      btn.closest(".team-cta")?.remove();
      return;
    }

    // Cap total stagger to ~320ms regardless of count (≤60ms/card).
    const step = Math.min(60, Math.round(320 / hidden.length));
    const first = hidden.map((el) => el.getBoundingClientRect());

    block.classList.remove("hidden");
    hidden.forEach((el) => el.classList.remove("is-hidden"));

    // Invert: park cards back at their old spot; start hidden.
    hidden.forEach((el, i) => {
      const last = el.getBoundingClientRect();
      const dx = first[i].left - last.left, dy = first[i].top - last.top;
      el.style.transition = "none";
      el.style.transform = `translate(${dx}px, ${dy}px)`;
      el.style.opacity = "0";
      el.style.transform = "translateY(16px)";
    });

    // Play: next frame, release everything to its resting place.
    requestAnimationFrame(() => {
      hidden.forEach((el, i) => {
        const d = i * step;
        el.style.transition = `opacity ${DUR - 50}ms ease ${d}ms, transform ${DUR}ms cubic-bezier(.2,.7,.2,1) ${d}ms`;
        el.style.opacity = "";
        el.style.transform = "";
      });
    });

    // Clear inline styles after the LAST card finishes.
    const settle = (hidden.length - 1) * step + DUR + 80;
    setTimeout(() => {
      hidden.forEach((el) => {
        el.style.transition = ""; el.style.transform = ""; el.style.opacity = "";
      });
    }, settle);

    btn.closest(".team-cta")?.remove();
  });
</script>
