    process: [
      { icon: "search", title: "Audit and assessment", text: "We conduct a comprehensive analysis of the current state of occupational health and safety, industrial safety and ecology. We identify production risks and areas of non-compliance with legislation. We propose objective solutions without imposing unnecessary services." },
