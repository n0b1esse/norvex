const c = CONTENT[lang as keyof typeof CONTENT] ?? CONTENT.ru;

// Последние новости для главной (3 свежих)
const latestNews = [...NEWS].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 3);

const categoryLabel = {
  ru: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
  en: { "Законодательство": "Legislation", "Компания": "Company", "Экспертиза": "Expertise", "События": "Events" },
  ky: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
}[lang];

const formatDate = (iso: string) => {
  const d = new Date(iso);
  const opts: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
  return lang === "ky" ? d.toLocaleDateString("ky-KG", opts) : d.toLocaleDateString(lang === "en" ? "en-US" : "ru-RU", opts);
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim() },
  })),
};
---
<Layout lang={lang} title={t("seo.home.title")} description={t("seo.home.desc")}>
  <section class="hero">
    {heroSrc && <img class="hero-bg" src={heroSrc} alt="" aria-hidden="true" />}
    <div class="container">
      <div class="hero-text">
        <h1>{c.hero.title}</h1>
        <p>{c.hero.subtitle}</p>
        <div class="hero-cta">
          <a href={lp(lang, "/contacts")} class="btn btn-primary">{t("cta.consult")}</a>
          <a href={lp(lang, "/about")} class="btn btn-outline">{t("cta.learn_more")}</a>
        </div>
      </div>

      <div class="hero-features">
        {c.hero.features.map((f) => (
          <div class="hero-feature">
            <span class="icon-badge icon-circle on-dark"><Icon name="shield-check" size={28} /></span>
            <span>{f}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">{c.trioTitle}</h2>
        <div class="bar"></div>
      </div>
      <div class="trio">
        {c.trio.map((item, i) => (
          <div class="trio-item reveal" style={`--i:${i}`}>
            <div class="trio-head">
              <span class="icon-badge"><Icon name={item.icon} size={34} /></span>
              <h3>{item.title}</h3>
            </div>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="process">
    <div class="container">
      <div class="section-head reveal" style="--i:0">
        <h2 class="section-title" set:html={c.processTitle}></h2>
        <div class="bar"></div>
        <p class="section-lead">{c.processLead}</p>
      </div>
      <div class="process-steps">
        {c.process.map((step, i) => (
          <div class="card process-step reveal" style={`--i:${i + 1}`}>
            <div class="process-top">
              <span class="icon-badge"><Icon name={step.icon} size={30} /></span>
              <span class="step-no">0{i + 1}</span>
            </div>
            <h3 class="process-title">{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="trusted">
    <div class="container">
      <div class="section-head reveal" style="--i:0">
        <h2 class="section-title" set:html={c.trustedTitle}></h2>
        <div class="bar"></div>
        <p class="section-lead">{c.trustedLead}</p>
      </div>
      <div class="trusted-grid">
        {c.trusted.map((brand, i) => (
          <div class="trust-card reveal" style={`--i:${i + 1}`}>
            <img src={`/assets/logos/${brand.file}`} alt={brand.name} width="160" height="160" />
            <p class="trust-name">{brand.name}<br /><span style="font-weight:400;font-size:11px;opacity:.7;text-transform:uppercase">{brand.cat}</span></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer" id="news">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title">{t("news_section_title")}</h2>
        <div class="bar"></div>
        <p class="section-lead">{t("news_section_lead")}</p>
      </div>
      <div class="grid grid-3">
        {latestNews.map((n, i) => (
          <article class="card news-item reveal" style={`--i:${i + 1}`}>
            <div class="news-media">
              {n.image ? (
                <img src={n.image} alt={n.title[lang]} class="news-img" loading="lazy" width={400} height={260} />
              ) : (
                <div class="placeholder" style="min-height:200px"><Icon name="newspaper" size={36} /></div>
              )}
            </div>
            <div class="news-body">
              <div class="news-meta">
                <span class="news-category">{categoryLabel[n.category]}</span>
                <span class="news-date">{formatDate(n.date)}</span>
              </div>
              <h3 class="news-title">{n.title[lang]}</h3>
              <p class="news-excerpt">{n.excerpt[lang]}</p>
              <a href={lp(lang, `/news/${n.slug}`)} class="btn btn-outline-green">{t("news_section_cta")} <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-soft" id="faq">
    <div class="container">
      <div class="section-head reveal" style="--i:0">
        <h2 class="section-title" set:html={c.faqTitle}></h2>
        <div class="bar"></div>
        <p class="section-lead">{c.faqLead}</p>
      </div>
      <div class="faq-list">
        {c.faq.map((item, i) => {
          const g = (item as unknown as { group?: string }).group ?? "";
          const prevG = i > 0 ? ((c.faq[i - 1] as unknown as { group?: string }).group ?? "") : "";
          return (
            <>
              {g && g !== prevG ? <h3 class="faq-group">{g}</h3> : null}
              <details class="card faq-item reveal" style={`--i:${i + 1}`} open={i === 0 || undefined}>
                <summary>{item.q}<span class="chev" aria-hidden="true"><Icon name="chevron-right" size={14} /></span></summary>
                <div class="faq-body" set:html={item.a.includes("<") ? item.a : `<p>${item.a}</p>`} />
              </details>
            </>
          );
        })}
      </div>
      <div class="faq-cta reveal" style="--i:0">
        <a class="btn btn-primary" href={lp(lang, "/contacts")}>{c.faqCta}</a>
      </div>
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} is:inline />
  </section>
</Layout>

