---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";
import { NEWS } from "../../data/news";
import { directus, asset } from "../../lib/directus";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Локальный контент главной — сайт работает без Directus CMS.
// hero_image подтягивается из CMS (Directus), остальное — локальный контент.
const raw = await directus<{ hero_image?: string | null }>("/items/home_page?fields=hero_image", {});
const heroSrc = asset(raw.hero_image);

// Локальный контент главной — сайт работает без Directus CMS.
const CONTENT = {
  ru: {
    hero: {
      title: "Профессиональные решения в области охраны труда, промышленной безопасности, охраны окружающей среды и управления рисками",
      subtitle: "Консалтинг, аутсорсинг и аутстаффинг для организаций, ориентированных на безопасность, эффективность и устойчивое развитие.",
      features: ["Профессиональная экспертиза", "Риск-ориентированный подход", "Независимость и объективность", "Лучшие международные практики"],
    },
    trioTitle: "Кто мы, что делаем, для кого",
    trio: [
      { icon: "users", title: "Кто мы", text: "Экспертный партнер организаций в вопросах охраны труда, промышленной безопасности, охраны окружающей среды и управления рисками." },
      { icon: "clipboard-check", title: "Что мы делаем", text: "Оказываем услуги консалтинга, аутсорсинга и аутстаффинга, направленные на повышение уровня безопасности и эффективности деятельности организаций." },
      { icon: "building-2", title: "Для кого", text: "Для организаций, стремящихся обеспечить безопасность, соответствие требованиям и устойчивое развитие своей деятельности." },
    ],
    processTitle: 'Как мы <span class="accent">работаем</span>',
    processLead: "Прозрачный процесс: от первичной оценки до устойчивого результата. Вы всегда контролируете этапы работы и понимаете структуру затрат.",
    process: [
      { icon: "search", title: "Аудит и оценка", text: "Проводим комплексный анализ текущего состояния охраны труда, промышленной безопасности и экологии. Идентифицируем производственные риски и зоны несоответствия законодательству. Предлагаем объективные пути решения без навязанных услуг." },
      { icon: "file-text", title: "Решение и договор", text: "Определяем оптимальную модель сотрудничества: консалтинг, аутсорсинг или аутстаффинг. Формируем прозрачную смету, регламент взаимодействия и фиксируем весь объём обязательств в договоре." },
      { icon: "user-check", title: "Реализация и внедрение", text: "Принимаем на себя функции службы ОТ, ПБ и ООС, интегрируем профильного специалиста в ваши процессы или разрабатываем пакет документации. Работаем в строгом соответствии с согласованным графиком и производственными регламентами." },
      { icon: "clipboard-check", title: "Отчётность и контроль", text: "Предоставляем регулярную отчётность о статусе безопасности на объекте. Мониторим изменения в законодательстве КР и своевременно адаптируем вашу систему управления под новые нормативные требования." },
    ],
    trustedTitle: 'Нам доверяют <span class="accent">лидеры рынка</span>',
    trustedLead: "Крупные предприятия Кыргызстана и региона выбирают NORVEX для построения эффективной системы управления охраной труда, промышленной безопасностью и экологией. Мы обеспечиваем надежную защиту бизнеса от рисков",
    trusted: [
      { file: "real_siemens.svg", name: "Сименс", cat: "Горнодобыча" },
      { file: "real_abb.svg", name: "АББ", cat: "Промышленность" },
      { file: "real_schneider.svg", name: "Шнайдер Электрик", cat: "Строительство" },
      { file: "real_caterpillar.svg", name: "Катерпиллар", cat: "Тяжёлая техника" },
      { file: "real_honeywell.svg", name: "Хонейвелл", cat: "Логистика" },
      { file: "real_gazprom.svg", name: "Газпром", cat: "Нефтегаз" },
      { file: "real_total.svg", name: "Тотал Энерги", cat: "Энергетика" },
      { file: "real_beeline.svg", name: "Билайн", cat: "Телеком" },
    ],
    faqTitle: 'Частые <span class="accent">вопросы</span>',    faqLead: "Коротко о том, как устроено сотрудничество. Не нашли свой вопрос — напишите нам, ответим в течение рабочего дня.",
    faq: [
      { group: "Базовые понятия", q: "Что такое охрана труда простыми словами?", a: "Охрана труда — это система сохранения жизни и здоровья работников в процессе их трудовой деятельности. Это не просто бумажки, а комплекс мер: от правильной организации рабочих мест и выдачи спецодежды до обучения и медосмотров. В Кыргызстане это регулируется Трудовым кодексом и профильным Законом «Об охране труда». Задача работодателя — создать такие условия, при которых риск травм и заболеваний на работе сведён к минимуму." },
      { group: "Базовые понятия", q: "Что такое промышленная безопасность и чем она отличается от охраны труда?", a: "Промышленная безопасность — это защищённость жизненно важных интересов личности и общества от аварий на опасных производственных объектах (например, на шахтах, заводах, объектах энергетики) и их последствий. Если охрана труда фокусируется на каждом сотруднике и его действиях в течение рабочего дня, то промышленная безопасность фокусируется на техническом состоянии оборудования, зданий и производственных процессов в целом, чтобы предотвратить катастрофы." },
      { group: "Базовые понятия", q: "Что такое пожарная безопасность?", a: "Согласно Закону КР «О пожарной безопасности», это состояние защищённости личности, имущества, общества и государства от пожаров. Она включает в себя правовые, организационные и технические меры: от наличия огнетушителей и планов эвакуации до соблюдения правил эксплуатации электрооборудования и проведения противопожарных инструктажей." },
      { group: "Базовые понятия", q: "Что такое охрана окружающей среды (ООС)?", a: "Это система государственных и общественных мер, направленных на гармоничное взаимодействие общества и природы, сохранение и воспроизводство природных ресурсов. Для бизнеса в Кыргызстане это означает соблюдение экологических норм: от получения разрешений на выбросы и размещения отходов до проведения обязательной экологической экспертизы проектов." },
      { group: "Законодательство и обязанности", q: "Работодатель обязан проводить оценку профессиональных рисков?", a: "Да. И Трудовой кодекс, и Закон «Об охране труда» обязывают работодателя обеспечивать оценку профессиональных рисков. Однако законодательство КР не устанавливает строгую периодичность (например, «раз в 5 лет»), поэтому мы рекомендуем проводить оценку регулярно, особенно при изменении технологических процессов или внедрении нового оборудования. NORVEX помогает провести оценку рисков и оформить результаты." },
      { group: "Законодательство и обязанности", q: "Каковы главные обязанности работодателя перед работниками и государством?", a: "<p>Работодатель обязан:</p><ul><li>Обеспечить безопасные условия труда на каждом рабочем месте.</li><li>Бесплатно выдавать качественные СИЗ (спецодежду, обувь).</li><li>Проводить инструктажи и проверку знаний по охране труда.</li><li>Организовывать обязательные медосмотры.</li><li>Проводить оценку профессиональных рисков и аттестацию рабочих мест.</li><li>Страховать работников от несчастных случаев на производстве.</li></ul><p>Перед государством обязанность — соблюдать все нормативы, своевременно отчитываться в надзорные органы и устранять выявленные нарушения.</p>" },
      { group: "Законодательство и обязанности", q: "Правда ли, что специалист по охране труда нужен только если сотрудников больше 50?", a: "Да, это ключевой порог. В организациях с численностью более 50 работников, ведущих производственную деятельность, создание службы охраны труда или введение должности специалиста обязательно. Если сотрудников 50 и менее, решение принимает работодатель. Однако, если вы решите не вводить ставку, вы всё равно обязаны обеспечить безопасность — в этом случае законодательство позволяет заключить договор на аутсорсинг со специализированной организацией (например, NORVEX)." },
      { group: "Законодательство и обязанности", q: "Кто должен оплачивать спецодежду и средства индивидуальной защиты (СИЗ)?", a: "Расходы полностью несёт работодатель. Вы не имеете права перекладывать стоимость СИЗ на сотрудников или удерживать её из зарплаты. За счёт работодателя осуществляются не только покупка, но и хранение, стирка, ремонт и обезвреживание СИЗ. Мы можем помочь с разработкой норм выдачи СИЗ и порядка их учёта." },
      { group: "Законодательство и обязанности", q: "Можно ли заменить обязательный медосмотр устным опросом сотрудника?", a: "Нет, это прямое нарушение. Предварительные (при приёме на работу) и периодические медосмотры должны проводиться в государственных учреждениях здравоохранения. Устный опрос не имеет юридической силы, и допуск к работе без медосмотра запрещён. NORVEX помогает организовать процесс медосмотров и вести соответствующую документацию." },
      { group: "Законодательство и обязанности", q: "Нужно ли разрабатывать план эвакуации, если помещение небольшое и риск пожара низкий?", a: "Да, нужно. Законодательство обязывает размещать поэтажные планы эвакуации на всех объектах защиты (независимо от формы собственности и размера), на которые распространяются требования пожарной безопасности. Мнение работодателя о «низком риске» не отменяет эту норму. Мы разрабатываем планы эвакуации и документацию по пожарной безопасности." },
      { group: "Последствия и риски", q: "Что будет, если не соблюдать требования охраны труда, пожарной и экологической безопасности?", a: "<p>Последствия делятся на три группы:</p><ul><li><strong>Финансовые:</strong> крупные штрафы для компании и должностных лиц. Например, за нарушения в области экологии в КР ужесточаются штрафы, а надзорные органы (СЭТН) активно проводят проверки.</li><li><strong>Административные:</strong> приостановка деятельности предприятия (например, остановка работы опасного участка или оборудования) до устранения нарушений.</li><li><strong>Уголовные и личные:</strong> при несчастном случае с тяжёлым исходом или крупном экологическом ущербе руководитель может нести уголовную ответственность, а также полную материальную ответственность за вред здоровью сотрудника.</li></ul>" },
      { group: "Последствия и риски", q: "Что грозит компании за несчастный случай на производстве?", a: "Помимо штрафов, руководитель может нести полную финансовую ответственность за вред здоровью сотрудника. В КР ужесточается ответственность работодателей, включая обязательную аттестацию рабочих мест и строгий контроль за соблюдением требований. NORVEX помогает подготовить компанию к проверкам и минимизировать риски." },
      { group: "Выгоды и международные стандарты", q: "Что даёт компании соблюдение требований безопасности, кроме отсутствия штрафов?", a: "<p>Помимо защиты от штрафов, вы получаете:</p><ul><li><strong>Репутацию:</strong> компания, где безопасность на высоте, более привлекательна для инвесторов и партнёров.</li><li><strong>Снижение издержек:</strong> меньше больничных, меньше страховых случаев, ниже текучка кадров.</li><li><strong>Конкурентоспособность:</strong> соответствие международным стандартам (например, ISO 45001) открывает двери для сотрудничества с крупными международными корпорациями и участия в тендерах.</li></ul>" },
      { group: "Выгоды и международные стандарты", q: "Что такое сертификация ISO и какие виды существуют?", a: "<p>ISO — это международная организация по стандартизации. Сертификация ISO подтверждает, что система управления компании соответствует мировым требованиям. Для вашей сферы наиболее актуальны:</p><ul><li>ISO 9001 — менеджмент качества.</li><li>ISO 14001 — экологический менеджмент (ООС).</li><li>ISO 45001 — менеджмент охраны здоровья и безопасности труда (заменил старый OHSAS 18001).</li></ul><p>Отличие: это не просто «корочка», а подтверждение того, что ваши процессы (от закупки СИЗ до действий при аварии) выстроены системно и нацелены на постоянное улучшение.</p>" },
      { group: "Выгоды и международные стандарты", q: "В чём отличие ISO 14001 от ISO 45001?", a: "ISO 14001 фокусируется на том, как ваша компания влияет на внешнюю среду (выбросы, отходы, потребление ресурсов). ISO 45001 фокусируется на внутренней среде — на том, как вы защищаете своих сотрудников от травм и профзаболеваний на рабочем месте. Внедрение обеих систем (интегрированная система менеджмента) даёт максимальный эффект для выхода на международный уровень." },
      { group: "Аутсорсинг и аутстаффинг", q: "Чем отличается аутсорсинг от аутстаффинга охраны труда?", a: "При аутсорсинге мы полностью берём на себя функции вашей службы охраны труда: проводим аудиты, разрабатываем документацию, организуем процессы и представляем ваши интересы в госорганах. При аутстаффинге мы предоставляем вам квалифицированного специалиста, который фактически работает на вашей территории и подчиняется вашему руководству, но числится в штате NORVEX. Это позволяет быстро закрыть потребность в инженере по ОТ без затрат на создание рабочего места и выплату налогов." },
      { group: "Аутсорсинг и аутстаффинг", q: "Если мы передадим охрану труда на аутсорсинг, кто будет отвечать, если произойдёт несчастный случай?", a: "Ответственность перед государством и пострадавшим работником всегда несёт работодатель (ваша компания). Однако если NORVEX оказывал услуги некачественно (например, не выявил опасный фактор, который входил в наши обязанности по договору), мы несём ответственность в рамках договора и возмещаем ущерб. Наша задача — сделать так, чтобы у инспекторов Госинспекции труда не было претензий к вам." },
      { group: "Аутсорсинг и аутстаффинг", q: "Приедет ли ваш специалист к нам на производство или будет работать удалённо?", a: "Формат работы зависит от договора. При аутсорсинге специалист NORVEX регулярно посещает объект для проведения аудитов, проверки документации и оценки условий труда. При аутстаффинге специалист находится на вашей территории в соответствии с вашим графиком работы. Мы не работаем «вслепую» — для качественного результата нужен доступ к реальным условиям труда." },
      { group: "Аутсорсинг и аутстаффинг", q: "У нас уже есть инженер по охране труда, но он не справляется с объёмом (или уходит в отпуск). Можете помочь?", a: "Да. Мы предлагаем услуги по аутстаффингу на время (например, на период декретного отпуска или болезни штатного специалиста) или можем взять на себя отдельные функции (например, только аудит, только разработку документации или только сопровождение проверок). Это часто дешевле и быстрее, чем искать временного сотрудника в штат." },
      { group: "Аутсорсинг и аутстаффинг", q: "Мы уже работаем с другим подрядчиком по охране труда. Зачем нам переходить к вам?", a: "Мы предлагаем риск-ориентированный подход и независимую экспертизу. NORVEX не просто «закрывает бумажки» — мы выявляем реальные риски и помогаем выстроить систему так, чтобы у инспекторов Госинспекции труда не было претензий. Если вы сомневаетесь, мы можем провести разовый аудит текущего состояния дел и показать, где есть слабые места." },
      { group: "Документация, аудит и проверки", q: "Чем вы можете помочь, если у нас вообще нет никакой документации по охране труда?", a: "Мы проведём аудит, разработаем полный пакет необходимых документов (инструкции, журналы, приказы, положения), настроим систему учёта и обучим ваших сотрудников правильному ведению документации. Всё — в соответствии с требованиями законодательства КР." },
      { group: "Документация, аудит и проверки", q: "Нужно ли нам обновлять инструкции по охране труда, если изменилось оборудование?", a: "Обязательно. Инструкции по охране труда должны пересматриваться не реже одного раза в 5 лет, а также досрочно при изменении технологического процесса, замене оборудования или по требованию органов надзора. NORVEX может актуализировать ваши инструкции и привести их в соответствие с новыми нормами КР." },
      { group: "Документация, аудит и проверки", q: "Что входит в аудит охраны труда и сколько он занимает времени?", a: "Аудит включает проверку документации, оценку условий труда на рабочих местах, выявление нарушений и рисков, а также рекомендации по их устранению. Сроки зависят от размера объекта и количества рабочих мест — обычно от нескольких дней до двух недель. По итогам вы получаете отчёт с планом действий." },
      { group: "Документация, аудит и проверки", q: "Вы помогаете пройти проверку Госинспекции труда?", a: "Да. Мы можем провести предпроверочный аудит, подготовить необходимые документы, а также сопровождать вас во время проверки — представлять интересы компании и помогать оперативно устранять замечания." },
      { group: "Документация, аудит и проверки", q: "Разрабатываете ли вы документацию по пожарной безопасности и охране окружающей среды?", a: "Да. NORVEX разрабатывает документацию по пожарной безопасности (планы эвакуации, инструкции, приказы), а также помогает с документацией по охране окружающей среды и промышленной безопасности — в соответствии с требованиями КР." },
      { group: "Документация, аудит и проверки", q: "Работаете ли вы по всей территории Кыргызстана?", a: "Да. Наши специалисты выезжают на объекты по всей республике. Мы сопровождаем компании в Бишкеке, Оше, Джалал-Абаде, а также в отдалённых регионах, включая промышленные и горнодобывающие объекты." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Какое образование должно быть у специалиста по охране труда?", a: "Специалист по охране труда должен иметь высшее профессиональное образование по направлению «Охрана труда», «Техносферная безопасность» или смежной инженерной специальности, либо высшее образование и профессиональную переподготовку по охране труда. Без профильного образования или переподготовки занимать должность специалиста по ОТ нельзя. Дополнительно требуется периодическая проверка знаний по охране труда." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Какое образование нужно для специалиста по промышленной безопасности?", a: "Для работы в области промышленной безопасности требуется высшее техническое образование, соответствующее профилю опасного производственного объекта (горное дело, энергетика, металлургия, химия и т.п.), а также подготовка и аттестация в области промышленной безопасности. Специалист должен знать требования к опасным производственным объектам и уметь организовывать производственный контроль." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Какое образование требуется для специалиста по охране окружающей среды (эколога)?", a: "Как правило, требуется высшее образование по направлению «Экология», «Охрана окружающей среды», «Природопользование» или смежной специальности (химия, биология, география — в зависимости от отрасли). Дополнительно важны знания экологического законодательства КР, порядка получения разрешений и сдачи отчётности." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Какое образование нужно для специалиста по пожарной безопасности?", a: "Требуется высшее или среднее профессиональное техническое образование, preferably по направлению «Пожарная безопасность» либо прохождение специальной подготовки (переподготовки) по пожарной безопасности. Специалист должен знать требования пожарной безопасности, уметь разрабатывать документацию и организовывать противопожарные мероприятия." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Можно ли назначить одного человека ответственным за ОТ, ПБ, ООС и пожарную безопасность сразу?", a: "Формально совмещение возможно, если сотрудник соответствует квалификационным требованиям по каждому направлению (образование + подготовка/аттестация). На практике это редко бывает корректно: направления требуют разных знаний и разной подготовки. Оптимально — либо раздельные специалисты, либо аутсорсинг/аутстаффинг с нашей стороны, где мы закрываем все направления профильными экспертами." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Достаточно ли курсов повышения квалификации, если у специалиста непрофильное образование?", a: "Нет, одних курсов недостаточно. Если образование не профильное, требуется профессиональная переподготовка (как правило, от 250 часов) по соответствующему направлению, дающая право на ведение деятельности. Курсы повышения квалификации — это дополнение к уже имеющемуся профильному образованию, а не его замена." },
      { group: "Требования к специалистам (образование и квалификация)", q: "Как NORVEX проверяет квалификацию своих специалистов?", a: "Мы привлекаем специалистов с профильным образованием и подтверждённой подготовкой по направлениям (ОТ, ПБ, ООС, пожарная безопасность). Перед допуском к проекту мы проверяем документы об образовании, переподготовке и аттестации, а также релевантный опыт в отрасли клиента. Для сложных объектов (горнодобыча, опасные производственные объекты) подбираем экспертов с соответствующим техническим профилем." },
    ],
