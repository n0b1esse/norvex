---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// «Почему выбирают NORVEX» — 5 блоков, 3 локали.
const BLOCKS: Record<string, { icon: string; title: string; text: string }[]> = {
  ru: [
    { icon: "shield-check", title: "Наше предназначение", text: "Мы помогаем бизнесу работать без аварий, штрафов и простоев. Наша цель — сделать так, чтобы безопасность стала не обузой, а фундаментом для устойчивого роста и процветания вашей компании." },
    { icon: "hard-hat", title: "Наши эксперты", text: "Наша команда — это практики с международным опытом и глубоким знанием местного законодательства КР. Мы не теоретики: за плечами наших специалистов — реальные проекты в промышленности и энергетике." },
    { icon: "award", title: "Международная практика", text: "При основании компании в 2026 году мы внедрили лучшие мировые стандарты менеджмента в области ОТ, ПБ и ООС. Мы приносим на рынок Кыргызстана передовой опыт управления рисками, адаптируя его под местные реалии." },
    { icon: "settings", title: "Комплексный подход", text: "Мы закрываем весь спектр задач: от консалтинга и аудита до полного аутсорсинга и аутстаффинга. Вы получаете единый центр компетенций по направлениям ОТ, ПБ, ООС и пожарной безопасности." },
    { icon: "search", title: "Риск-ориентированный подход", text: "Мы не просто проверяем соответствие бумаг. Мы анализируем реальные производственные риски и предлагаем решения, которые защищают ваших сотрудников, активы и репутацию перед инспекторами." },
  ],
  en: [
    { icon: "shield-check", title: "Our purpose", text: "We help businesses work without accidents, fines and downtime. Our goal is to make safety not a burden, but the foundation for sustainable growth and prosperity of your company." },
    { icon: "hard-hat", title: "Our experts", text: "Our team are practitioners with international experience and in-depth knowledge of local Kyrgyz legislation. We are not theorists: our specialists have real projects in industry and energy behind them." },
    { icon: "award", title: "International practice", text: "At the founding of the company in 2026, we introduced the best world standards of management in occupational health and safety, industrial safety and environmental protection. We bring advanced risk management experience to the Kyrgyz market, adapting it to local realities." },
    { icon: "settings", title: "Integrated approach", text: "We cover the full range of tasks: from consulting and auditing to full outsourcing and outstaffing. You get a single centre of expertise in occupational health and safety, industrial safety, environmental protection and fire safety." },
    { icon: "search", title: "Risk-based approach", text: "We do not just check paperwork compliance. We analyse real production risks and propose solutions that protect your employees, assets and reputation with inspectors." },
  ],
  ky: [
    { icon: "shield-check", title: "Биздин миссиябыз", text: "Биз бизнеске авариясыз, айып пулсуз жана токтоосуз иш жүргүзүүгө жардам беребиз. Биздин максат — коопсуздукту жүк катары эмес, компанияңыздын туруктуу өсүүсү жана бакубаттыгынын пайдубалына айландыруу." },
    { icon: "hard-hat", title: "Биздин эксперттер", text: "Биздин команда — эл аралык тажрыйбага жана КР жергиликтүү мыйзамдарын терең билген практиктер. Биз теоретик эмеспиз: адистерибиздин артында өнөр жай жана энергетикадагы чыныгы долбоорлор бар." },
    { icon: "award", title: "Эл аралык практика", text: "2026-жылы компания негизделген учурда ОТ, ПБ жана ООС боюнча башкаруунун мыкты дүйнөлүк стандарттарын киргиздик. Биз Кыргызстан рыногуна тобокелдиктерди башкаруунун алдыңкы тажрыйбасын, аны жергиликтүү шартка ылайыкташтырып алып келебиз." },
    { icon: "settings", title: "Комплекстүү мамиле", text: "Биз бардык спектрдеги милдеттерди жабабыз: консалтинг жана аудиттен — толук аутсорсинг жана аутстаффингге чейин. Сиз ОТ, ПБ, ООС жана өрт коопсуздугу боюнча бирдиктүү компетенция борборун аласыз." },
    { icon: "search", title: "Тобокелдикке негизделген мамиле", text: "Биз жөн гана кагаздардын шайкештигин текшербейбиз. Биз чыныгы өндүрүштүк тобокелдиктерди талдап, кызматкерлериңизди, активтериңизди жана инспекторлор алдындагы кадыр-баркыңызды коргой турган чечимдерди сунуштайбыз." },
  ],
};
const advantages = (BLOCKS[lang ?? "ru"] ?? BLOCKS.ru) as { icon: string; title: string; text: string }[];

// Локальный контент страницы — сайт работает без CMS
const about = {
  title: lang === "en" ? "About the company" : lang === "ky" ? "Компания жөнүндө" : "О компании",
  intro: lang === "en"
    ? [
      "NORVEX LLC is a dynamically developing consulting company founded in 2026. Our goal is to ensure safety, efficiency and sustainable development of organisations in the Kyrgyz Republic and the region.",
      "We specialise in providing professional services in occupational health and safety, industrial safety, fire safety and environmental protection. Our portfolio of solutions includes consulting, outsourcing and outstaffing, as well as comprehensive management of occupational risks.",
      "Our main competitive advantage is a synthesis of international experience and deep understanding of local legislation. The founder of the company, Abdraimov Tumarbek Abdraimovich, laid the foundation of a business focused on best world practices. We do not just keep up with change — we help businesses adapt to it.",
      "The rapid growth of NORVEX LLC is driven by client trust and our striving for continuous improvement. We provide expert support at every stage, guaranteeing compliance with all regulatory requirements and raising the overall safety culture at enterprises.",
    ]
    : lang === "ky"
      ? [
        "ОсОО «НОРВЕКС» — 2026-жылы негизделген динамикалуу өсүп жаткан консалтинг компаниясы. Биздин максат — Кыргыз Республикасында жана региондо уюмдардын коопсуздугун, натыйжалуулугун жана туруктуу өнүгүүсүн камсыз кылуу.",
        "Биз эмгекти коргоо, өнөр жай, өрт жана экологиялык коопсуздук жаатында кесипкөй кызматтарды көрсөтүүгө адистештик. Биздин чечимдер пакетине консалтинг, аутсорсинг жана аутстаффинг, ошондой эле кесиптик тобокелдиктерди комплекстүү башкаруу кирет.",
        "Биздин негизги артыкчылыгыбыз — эл аралык тажрыйбанын жана жергиликтүү мыйзамдарды терең түшүнүүнүн айкалышы. Компаниянын негиздөөчүсү, Абдраимов Тумарбек Абдраимович, мыкты дүйнөлүк практикаларга багытталган бизнестин пайдубалын түптөдү. Биз жөн гана өзгөрүүлөргө ылайык жүрбөйбүз, бизнеске аларга ыңгайлашууга жардам беребиз.",
        "ОсОО «НОРВЕКС»тин тез өсүшү кардарлардын ишенимине жана үзгүлтүксүз жакшыртууга умтулууына байланыштуу. Биз ар бир этапта эксперттик колдоону камсыз кылып, бардык нормативдик талаптардын сакталышына кепилдик берип, ишканаларда жалпы коопсуздук маданиятын жогорулатабыз.",
      ]
      : [
        "ОсОО «НОРВЕКС» — динамично развивающаяся консалтинговая компания, основанная в 2026 году. Наша цель — обеспечение безопасности, эффективности и устойчивого развития организаций в Кыргызской Республике и регионе.",
        "Мы специализируемся на предоставлении профессиональных услуг в области охраны труда, промышленной, пожарной и экологической безопасности. Наш портфель решений включает консалтинг, аутсорсинг и аутстаффинг, а также комплексное управление профессиональными рисками.",
        "Наше главное конкурентное преимущество — это синтез международного опыта и глубокого понимания местного законодательства. Основатель компании, Абдраимов Тумарбек Абдраимович, заложил фундамент бизнеса, ориентированного на лучшие мировые практики. Мы не просто следуем за изменениями, мы помогаем бизнесу к ним адаптироваться.",
        "Быстрый рост ОсОО «НОРВЕКС» обусловлен доверием клиентов и нашим стремлением к постоянному совершенствованию. Мы обеспечиваем экспертную поддержку на каждом этапе, гарантируя соблюдение всех нормативных требований и повышая общую культуру безопасности на предприятиях.",
      ],
  stats: lang === "en" ? [
    { value: "30+", label: "years of team experience" },
    { value: "20+", label: "successful projects" },
    { value: "10+", label: "industries of expertise" },
    { value: "4", label: "languages of service" },
  ] : lang === "ky" ? [
    { value: "30+", label: "жылдык команда тажрыйбасы" },
    { value: "20+", label: "ийгиликтүү долбоорлор" },
    { value: "10+", label: "экспертиза тармактары" },
    { value: "4", label: "тейлөө тили" },
  ] : [
    { value: "30+", label: "лет опыта команды" },
    { value: "20+", label: "успешных проектов" },
    { value: "10+", label: "отраслей экспертизы" },
    { value: "4", label: "языка обслуживания" },
  ],
  advantages,
};
const stats = about.stats;
const why = about.advantages;
const whyTitleHtml = t("about.why_title").replace(/NORVEX/g, '<span class="accent">NORVEX</span>');

---
<Layout lang={lang} title={t("seo.about.title")} description={t("seo.about.desc")}>
  <section class="page-hero">
    <img class="hero-bg" src="/norvexOffice.jpg" alt="" aria-hidden="true" />
    <div class="container">
      <div class="hero-text">
        <h1>{about.title}</h1>
        {about.intro.map((para) => (
          <p>{para}</p>
        ))}
        <a href={lp(lang, "/services")} class="btn btn-primary">{t("cta.about_more")} <Icon name="chevron-right" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="stats-wrap">
    <div class="container">
      <div class="stats card">
        {stats.map((s, i) => (
          <div class="stat reveal" style={`--i:${i}`}>
            <div class="stat-num">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <h2 class="section-title" set:html={whyTitleHtml}></h2>
        <div class="bar"></div>
      </div>
      <div class="why-grid">
        {why.map((w, i) => (
          <div class="why-item card reveal" style={`--i:${i}`}>
            <span class="icon-badge"><Icon name={w.icon} size={30} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero uses the shared .page-hero treatment in global.css; below is the
     About-page tweak: extra paragraph spacing for the CTA that sits below it. */
  .page-hero .hero-text p { margin: 16px 0 0; max-width: 620px; }
  .page-hero .hero-text p:first-of-type { margin-top: 22px; }
  .page-hero .hero-text p:last-of-type { margin-bottom: 30px; }

  .stats-wrap { background: var(--bg); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 36px 20px; transform: translateY(-40px); }
  .stat { text-align: center; padding: 8px 20px; }
  .stat:not(:last-child) { border-right: 1px solid var(--border); }
  .stat-num { font-size: clamp(34px, 4vw, 48px); font-weight: 800; color: var(--navy); }
  .stat-label { color: var(--muted); margin-top: 6px; font-size: 15px; }

  .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .why-item { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; text-align: left; padding: 26px 24px; }
  .why-item h3 { font-size: 17.5px; line-height: 1.35; }
  .why-item p { color: var(--muted); font-size: 15px; line-height: 1.6; }

  @media (max-width: 900px) {
    .stats { grid-template-columns: repeat(2, 1fr); gap: 24px 0; transform: translateY(-30px); }
    .stat:nth-child(2) { border-right: 0; }
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .stats { grid-template-columns: 1fr; }
    .stat:not(:last-child) { border-right: 0; border-bottom: 1px solid var(--border); padding-bottom: 20px; }
    .why-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Count the stat numbers up from 0 when the band scrolls into view. The final
  // CMS value is server-rendered, so no-JS / reduced-motion users see it as-is.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nums = document.querySelectorAll(".stat-num");
  if (!reduce && "IntersectionObserver" in window && nums.length) {
    const run = (el) => {
      const raw = el.textContent.trim();
      if (raw.includes("/")) return;                        // e.g. "24/7" — leave alone
      const m = raw.match(/^(\D*)([\d.,]+)(.*)$/s);
      if (!m) return;
      const end = parseFloat(m[2].replace(/[\s,]/g, ""));
      if (!isFinite(end)) return;
      const dec = (m[2].split(".")[1] || "").length;
      let t0;
      const step = (now) => {
        t0 ??= now;
        const p = Math.min((now - t0) / 1100, 1);
        el.textContent = m[1] + (end * (1 - Math.pow(1 - p, 3))).toFixed(dec) + m[3];
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.5 });
    nums.forEach((el) => io.observe(el));
  }
</script>
