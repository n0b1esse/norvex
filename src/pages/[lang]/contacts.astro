---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Локальные контакты — сайт работает без CMS
const phone = "+996 550 209 209";
const email = "info@norvex-hse.com";
const socials = {
  whatsapp: "https://wa.me/996550209209",
  telegram: "https://t.me/NORVEX_HSE",
  instagram: "https://www.instagram.com/norvex.hse/",
  linkedin: "https://www.linkedin.com/company/norvex-hse",
};
const address = lang === "en" ? "Kyrgyz Republic, Bishkek City, 7 Ankara Street, 223" : lang === "ky" ? "Кыргыз Республикасы, Бишкек шаары, Анкара көчөсү, 223" : "Кыргызская Республика, город Бишкек, улица Анкара, 223";
const workingHours = lang === "en" ? "Monday – Saturday, 09:00 – 20:00" : lang === "ky" ? "Дүйшөмбү – Ишемби, 09:00 – 20:00" : "Понедельник – Суббота, 09:00 – 20:00";
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&z=15&output=embed`;
const info = [
  { icon: "phone", label: t("contacts.phone"), values: [{ text: phone, href: `tel:${phone.replace(/\s|\(/g, "").replace(/\)/g, "")}` }] },
  { icon: "whatsapp", label: "WhatsApp", values: [{ text: phone, href: socials.whatsapp }] },
  { icon: "telegram", label: "Telegram", values: [{ text: "NORVEX_HSE", href: socials.telegram }] },
  { icon: "instagram", label: "Instagram", values: [{ text: "@norvex.hse", href: socials.instagram }] },
  { icon: "linkedin", label: "LinkedIn", values: [{ text: "NORVEX", href: socials.linkedin }] },
  { icon: "mail", label: "Email", values: [{ text: email, href: `mailto:${email}` }] },
  { icon: "map-pin", label: t("contacts.address"), values: [{ text: address }] },
  { icon: "clock", label: t("contacts.hours"), values: [{ text: workingHours }] },
];
---
<Layout lang={lang} title={t("seo.contacts.title")} description={t("seo.contacts.desc")}>
  <section class="section">
    <div class="container">
      <div class="section-head left">
        <h1 class="section-title">{t("page.contacts_title")}</h1>
        <p class="section-lead">{t("page.contacts_lead")}</p>
      </div>

      <div class="contacts-grid">
        <ul class="info">
          {info.map((row) => (
            <li>
              <span class="icon-badge icon-circle"><Icon name={row.icon} size={24} /></span>
              <div>
                <span class="info-label">{row.label}</span>
                {row.values.map((v) => {
                  const external = !!v.href && v.href.startsWith("http");
                  return v.href
                    ? <a class="info-value" href={v.href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{v.text}</a>
                    : <span class="info-value">{v.text}</span>;
                })}
              </div>
            </li>
          ))}
        </ul>

        <form class="form card" data-form>
          <input type="text" name="name" placeholder={t("form.name")} required />
          <input type="text" name="company" placeholder={t("form.company")} />
          <input type="tel" name="phone" placeholder={t("form.phone")} required />
          <input type="email" name="email" placeholder={t("form.email")} />
          <textarea name="message" rows="4" placeholder={t("form.message")}></textarea>
          <label class="consent">
            <input type="checkbox" required data-consent />
            <span>{t("form.consent")} <a href={lp(lang, "/privacy")} target="_blank">{t("form.consent_link")}</a></span>
          </label>
          <button type="submit" class="btn btn-primary" disabled>{t("cta.send")}</button>
          <p class="form-note" data-note hidden></p>
        </form>

        <iframe
          class="map"
          src={mapSrc}
          title={`${t("contacts.address")}: ${address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div class="consult card">
        <span class="help-icon"><Icon name="phone" size={26} /></span>
        <div class="consult-text">
          <strong>{t("contacts.consult_title")}</strong>
          <span>{t("contacts.consult_text")}</span>
        </div>
        <a href={`tel:+996550209209`} class="btn btn-outline-green">{t("cta.consult")}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contacts-grid { display: grid; grid-template-columns: .95fr 1.05fr 1fr; gap: 32px; align-items: start; }
  .info { display: flex; flex-direction: column; gap: 26px; }
  .info li { display: flex; gap: 16px; align-items: flex-start; }
  .info .icon-circle { width: 52px; height: 52px; }
  .info-label { display: block; font-weight: 700; color: var(--navy); font-size: 15px; }
  .info-value { display: block; color: var(--muted); font-size: 14.5px; margin-top: 2px; overflow-wrap: anywhere; }
  a.info-value:hover { color: var(--green-600); }

  .form { padding: 30px; display: flex; flex-direction: column; gap: 16px; }
  .form input:not([type="checkbox"]), .form textarea {
    width: 100%; padding: 14px 16px; font: inherit; color: var(--ink);
    font-size: 16px; -webkit-appearance: none; appearance: none;
    border: 1px solid var(--border); border-radius: 9px; background: #fff; resize: vertical;
  }
  .form input:not([type="checkbox"]):focus, .form textarea:focus { outline: none; border-color: var(--green-500); box-shadow: 0 0 0 3px rgba(42,165,74,.12); }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; color: var(--muted); line-height: 1.5; cursor: pointer; }
  .consent input { margin-top: 2px; width: 16px; height: 16px; flex: none; accent-color: var(--green-600); cursor: pointer; }
  .consent a { color: var(--green-600); text-decoration: underline; }
  .form .btn { margin-top: 4px; }
  .form .btn:disabled { opacity: .45; cursor: not-allowed; }
  .form-note { color: var(--green-700); font-size: 14px; font-weight: 600; }

  .map { min-height: 380px; align-self: stretch; }
  iframe.map { width: 100%; height: 100%; border: 0; border-radius: var(--radius); display: block; }

  .consult { display: flex; align-items: center; gap: 18px; padding: 22px 26px; margin-top: 32px; background: #f1f8f3; border-color: #d6ebdc; }
  .help-icon { color: var(--green-600); flex: none; }
  .consult-text { display: flex; flex-direction: column; gap: 4px; margin-right: auto; }
  .consult-text strong { color: var(--navy); font-size: 16px; }
  .consult-text span { color: var(--muted); font-size: 14.5px; }

  @media (max-width: 980px) {
    .contacts-grid { grid-template-columns: 1fr 1fr; }
    .map { grid-column: 1 / -1; min-height: 300px; }
  }
  @media (max-width: 640px) {
    .contacts-grid { grid-template-columns: 1fr; }
    .consult { flex-direction: column; align-items: flex-start; }
  }
</style>

<script define:vars={{ msg: { sending: t("form.sending"), send: t("cta.send"), phone: "+996 550 209 209" } }}>
  // Форма работает без сервера: отправка на email/телефон будет добавлена позже;
  // пока сразу предлагаем позвонить по номеру, который виден на странице.
  const form = document.querySelector("[data-form]");
  const note = document.querySelector("[data-note]");
  const btn = form?.querySelector("button[type=submit]");
  const consent = form?.querySelector("[data-consent]");
  consent?.addEventListener("change", () => { if (btn) btn.disabled = !consent.checked; });
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (note) {
      note.hidden = false;
      note.style.color = "var(--green-700)";
      note.textContent = msg.phone;
    }
  });
</script>
