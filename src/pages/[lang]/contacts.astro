---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";
import { apiOne, asset } from "../../lib/api";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

const CONTENT = {
  ru: {
    address: "Кыргызская Республика, город Бишкек, улица Анкара, 223",
    hours: "Понедельник – Суббота, 09:00 – 20:00",
  },
  en: {
    address: "Kyrgyz Republic, Bishkek City, 7 Ankara Street, 223",
    hours: "Monday – Saturday, 09:00 – 20:00",
  },
  ky: {
    address: "Кыргыз Республикасы, Бишкек шаары, Анкара көчөсү, 223",
    hours: "Дүйшөмбү – Ишемби, 09:00 – 20:00",
  },
};
const c = CONTENT[lang ?? "ru"] ?? CONTENT.ru;

// Hero-фон — тот же, что на «Услугах» и «О компании»: из настроек сайта,
// иначе локальное изображение (страница остаётся работоспособной без CMS).
const about = await apiOne<{ about_image?: string | null }>("site_settings", { lang });
const officeImg = asset(about.about_image) ?? "/newOffice.png";

// Локальные контакты — сайт работает без CMS
const phone = "+996 550 209 209";
const email = "info@norvex-hse.com";
const socials = {
  whatsapp: "https://wa.me/996550209209",
  telegram: "https://t.me/NORVEX_HSE",
  instagram: "https://www.instagram.com/norvex.hse/",
  linkedin: "https://www.linkedin.com/company/norvex-hse",
};
;
const address = c.address;
;
const workingHours = c.hours;
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&z=15&output=embed`;
const info = [
  { icon: "phone", label: t("contacts.phone"), labelSlot: "global.contacts.phone", values: [{ text: phone, href: `tel:${phone.replace(/\s|\(/g, "").replace(/\)/g, "")}` }] },
  { icon: "whatsapp", label: "WhatsApp", values: [{ text: phone, href: socials.whatsapp }] },
  { icon: "telegram", label: "Telegram", values: [{ text: "NORVEX_HSE", href: socials.telegram }] },
  { icon: "instagram", label: "Instagram", values: [{ text: "@norvex.hse", href: socials.instagram }] },
  { icon: "linkedin", label: "LinkedIn", values: [{ text: "NORVEX", href: socials.linkedin }] },
  { icon: "mail", label: "Email", values: [{ text: email, href: `mailto:${email}` }] },
  { icon: "map-pin", label: t("contacts.address"), labelSlot: "global.contacts.address", values: [{ text: address, slot: "contacts.misc.address" }] },
  { icon: "clock", label: t("contacts.hours"), labelSlot: "global.contacts.hours", values: [{ text: workingHours, slot: "contacts.misc.hours" }] },
];

---
<Layout lang={lang} title={t("seo.contacts.title")} description={t("seo.contacts.desc")} livePage={"contacts"}>
  <section class="page-hero">
    {officeImg && <img class="hero-bg" src={officeImg} alt="" aria-hidden="true" data-live-hero="about_image" data-c-img="contacts.hero.image" />}
    <div class="container">
      <div class="hero-text">
        <h1 data-c="global.page.contacts_title">{t("page.contacts_title")}</h1>
        <p data-c="global.page.contacts_lead">{t("page.contacts_lead")}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contacts-grid">
        <ul class="info">
          {info.map((row) => (
            <li>
              <span class="icon-badge icon-circle"><Icon name={row.icon} size={24} /></span>
              <div>
                <span class="info-label" data-c={row.labelSlot}>{row.label}</span>
                {row.values.map((v) => {
                  const external = !!v.href && v.href.startsWith("http");
                  return v.href
                    ? <a class="info-value" href={v.href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined} data-c={v.slot}>{v.text}</a>
                    : <span class="info-value" data-c={v.slot}>{v.text}</span>;
                })}
              </div>
            </li>
          ))}
        </ul>

        <form class="form card" data-form>
          <input type="hidden" name="lang" value={lang} />
          <input type="text" name="name" placeholder={t("form.name")} required data-c-attr="placeholder:global.form.name" />
          <input type="text" name="company" placeholder={t("form.company")} data-c-attr="placeholder:global.form.company" />
          <input type="tel" name="phone" placeholder={t("form.phone")} required data-c-attr="placeholder:global.form.phone" />
          <input type="email" name="email" placeholder={t("form.email")} data-c-attr="placeholder:global.form.email" />
          <textarea name="message" rows="4" placeholder={t("form.message")} data-c-attr="placeholder:global.form.message"></textarea>
          <label class="consent">
            <input type="checkbox" required data-consent />
            <span><span data-c="global.form.consent">{t("form.consent")}</span> <a href={lp(lang, "/privacy")} target="_blank" data-c="global.form.consent_link">{t("form.consent_link")}</a></span>
          </label>
          <button type="submit" class="btn btn-primary" disabled data-c="global.cta.send">{t("cta.send")}</button>
          <p class="form-note" data-note hidden></p>
        </form>

        <iframe
          class="map"
          src={mapSrc}
          title={`${t("contacts.address")}: ${address}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>

      <div class="consult card">
        <span class="help-icon"><Icon name="phone" size={26} /></span>
        <div class="consult-text">
          <strong data-c="global.contacts.consult_title">{t("contacts.consult_title")}</strong>
          <span data-c="global.contacts.consult_text">{t("contacts.consult_text")}</span>
        </div>
        <a href={`tel:+996550209209`} class="btn btn-outline-green" data-c="global.cta.consult">{t("cta.consult")}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contacts-grid { display: grid; grid-template-columns: .95fr 1.05fr 1fr; gap: 32px; align-items: start; }
  .info { display: flex; flex-direction: column; gap: 26px; }
  .info li { display: flex; gap: 16px; align-items: flex-start; }
  .info .icon-circle { width: 52px; height: 52px; }
  .info-label { display: block; font-weight: 700; color: var(--navy); font-size: 15px; }
  .info-value { display: block; color: var(--muted); font-size: 14.5px; margin-top: 2px; overflow-wrap: anywhere; }
  a.info-value:hover { color: var(--green-600); }

  .form { padding: 30px; display: flex; flex-direction: column; gap: 16px; }
  .form input:not([type="checkbox"]), .form textarea {
    width: 100%; padding: 14px 16px; font: inherit; color: var(--ink);
    font-size: 16px; -webkit-appearance: none; appearance: none;
    border: 1px solid var(--border); border-radius: 9px; background: #fff; resize: vertical;
  }
  .form input:not([type="checkbox"]):focus, .form textarea:focus { outline: none; border-color: var(--green-500); box-shadow: 0 0 0 3px rgba(42,165,74,.12); }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; color: var(--muted); line-height: 1.5; cursor: pointer; }
  .consent input { margin-top: 2px; width: 16px; height: 16px; flex: none; accent-color: var(--green-600); cursor: pointer; }
  .consent a { color: var(--green-600); text-decoration: underline; }
  .form .btn { margin-top: 4px; }
  .form .btn:disabled { opacity: .45; cursor: not-allowed; }
  .form-note { color: var(--green-700); font-size: 14px; font-weight: 600; }

  .map { min-height: 380px; align-self: stretch; }
  iframe.map { width: 100%; height: 100%; border: 0; border-radius: var(--radius); display: block; }

  .consult { display: flex; align-items: center; gap: 18px; padding: 22px 26px; margin-top: 32px; background: #f1f8f3; border-color: #d6ebdc; }
  .help-icon { color: var(--green-600); flex: none; }
  .consult-text { display: flex; flex-direction: column; gap: 4px; margin-right: auto; }
  .consult-text strong { color: var(--navy); font-size: 16px; }
  .consult-text span { color: var(--muted); font-size: 14.5px; }

  @media (max-width: 980px) {
    .contacts-grid { grid-template-columns: 1fr 1fr; }
    .map { grid-column: 1 / -1; min-height: 300px; }
  }
  @media (max-width: 640px) {
    .contacts-grid { grid-template-columns: 1fr; }
    .consult { flex-direction: column; align-items: flex-start; }
  }
</style>

<script define:vars={{ msg: { sending: t("form.sending"), send: t("cta.send"), success: t("form.success"), error: t("form.error") } }}>
  // Строки статуса формы могут быть переопределены live-оверлеем из админки.
  const liveText = (key: string, fallback: string) =>
    ((window as unknown as { __liveTexts?: Record<string, string | null> }).__liveTexts?.[key]) || fallback;
  // Форма отправляет заявку на /send-inquiry.php (PHP на этом же хостинге):
  // скрипт пишет заявку в MySQL и отправляет письмо владельцу.
  const form = document.querySelector("[data-form]");
  const note = document.querySelector("[data-note]");
  const btn = form?.querySelector("button[type=submit]");
  const consent = form?.querySelector("[data-consent]");
  consent?.addEventListener("change", () => { if (btn) btn.disabled = !consent.checked; });
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (btn) {
      btn.disabled = true;
      btn.textContent = liveText("global.form.sending", msg.sending);
    }
    const fd = new FormData(form);
    try {
      const res = await fetch("/send-inquiry.php", { method: "POST", body: fd });
      const data = await res.json();
      if (note) {
        note.hidden = false;
        note.style.color = data.ok ? "var(--green-700)" : "var(--red-700)";
        note.textContent = data.ok
          ? (data.msg ?? liveText("global.form.success", msg.success))
          : (data.error ?? liveText("global.form.error", msg.error));
      }
      if (data.ok && form) form.reset();
    } catch (err) {
      if (note) {
        note.hidden = false;
        note.style.color = "var(--red-700)";
        note.textContent = liveText("global.form.error", msg.error);
      }
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = liveText("global.cta.send", msg.send);
      }
    }
  });
</script>
