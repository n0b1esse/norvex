---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Локальный контент документов — не зависит от CMS
const allCategories = lang === "en" ? [
  { slug: "policies", icon: "file-text", title: "Policies", heading: "Policies and regulations", lead: "Company policies on safety, environment and compliance.", docs: [
    { file: null, file_size: "PDF", title: "Occupational Safety Policy" },
    { file: null, file_size: "PDF", title: "Environmental Policy" },
    { file: null, file_size: "PDF", title: "Risk Management Policy" },
  ] },
  { slug: "procedures", icon: "clipboard", title: "Procedures", heading: "Work procedures and instructions", lead: "Procedures of NORVEX LLC confirming a systematic approach to work organisation and a high corporate safety culture.", docs: [
    { file: null, file_size: "PDF", title: "Work Safety Procedure" },
    { file: null, file_size: "PDF", title: "Incident Response Procedure" },
  ] },
  { slug: "checklists", icon: "check-square", title: "Checklists", heading: "Checklists and inspection forms", lead: "Methodological materials and checklists developed by NORVEX LLC to assess compliance with OHS, industrial safety and environmental requirements.", docs: [
    { file: null, file_size: "PDF", title: "HSE Inspection Checklist" },
    { file: null, file_size: "PDF", title: "Audit Report Form" },
  ] },
] : lang === "ky" ? [
  { slug: "policies", icon: "file-text", title: "Саясаттар", heading: "Саясат жана жобалар", lead: "Коопсуздук, экология жана шайкештик боюнча компаниянын саясаттары.", docs: [
    { file: null, file_size: "PDF", title: "Эмгекти коргоо саясаты" },
    { file: null, file_size: "PDF", title: "Айлана-чөйрөнү коргоо саясаты" },
    { file: null, file_size: "PDF", title: "Тобокелдиктерди башкаруу саясаты" },
  ] },
  { slug: "procedures", icon: "clipboard", title: "Процедуралар", heading: "Иш процедуралары жана нускамалар", lead: "ОсОО «НОРВЕКС» процедуралары, эмгекти уюштурууга системалык мамиле жана жогорку корпоративдик коопсуздук маданиятын ырастайт.", docs: [
    { file: null, file_size: "PDF", title: "Жумуш коопсуздугу процедураси" },
    { file: null, file_size: "PDF", title: "Окуя жооп берүү процедураси" },
  ] },
  { slug: "checklists", icon: "check-square", title: "Чек-листтер", heading: "Чек-листтер жана аудит формалары", lead: "ОсОО «НОРВЕКС» тарабынан ОТ, ПБ жана ООС талаптарына шайкештикти баалоо үчүн иштелип чыккан методикалык материалдар жана чек-листтер.", docs: [
    { file: null, file_size: "PDF", title: "HSE текшерүү чек-листи" },
    { file: null, file_size: "PDF", title: "Аудит отчетунун формасы" },
  ] },
] : [
  { slug: "policies", icon: "file-text", title: "Политики", heading: "Политики", lead: "Корпоративные политики в области безопасности, экологии и соответствия требованиям.", docs: [
    { file: null, file_size: "PDF", title: "Политика охраны труда" },
    { file: null, file_size: "PDF", title: "Экологическая политика" },
    { file: null, file_size: "PDF", title: "Политика управления рисками" },
  ] },
  { slug: "procedures", icon: "clipboard", title: "Процедуры", heading: "Процедуры", lead: "Процедуры ОсОО «НОРВЕКС», подтверждающие системный подход к организации труда и высокую корпоративную культуру безопасности.", docs: [
    { file: null, file_size: "PDF", title: "Процедура безопасности работ" },
    { file: null, file_size: "PDF", title: "Процедура реагирования на происшествия" },
  ] },
  { slug: "checklists", icon: "check-square", title: "Чек-листы", heading: "Чек-листы", lead: "Методические материалы и чек-листы ОсОО «НОРВЕКС», разработанные для оценки соответствия требованиям ОТ, ПБ и ООС.", docs: [
    { file: null, file_size: "PDF", title: "Чек-лист инспекции HSE" },
    { file: null, file_size: "PDF", title: "Форма аудита" },
  ] },
];
const categories = allCategories;
---
<Layout lang={lang} title={t("seo.documents.title")} description={t("seo.documents.desc")}>
  <section class="section bg-soft fill-to-footer">
    <div class="container docs-layout">
      <aside class="docs-side">
        {categories.map((c, i) => (
          <button class:list={["cat", { active: i === 2 }]} data-cat={c.slug}>
            <Icon name={c.icon} size={20} /> {c.title}
          </button>
        ))}
      </aside>

      <div class="docs-main">
        {categories.map((c, i) => (
          <div class:list={["docs-panel", { active: i === 2 }]} data-catpanel={c.slug}>
            <h1>{c.heading}</h1>
            <p class="docs-lead">{c.lead}</p>
            <ul class="doc-list">
              {c.docs.map((d) => (
                <li class="card doc-row">
                  <span class="pdf-badge">PDF</span>
                  <div class="doc-meta">
                    <span class="doc-name">{d.title}</span>
                    <span class="doc-sub">PDF{d.file_size ? `, ${d.file_size}` : ""}</span>
                  </div>

                </li>
              ))}
            </ul>
          </div>
        ))}

        <div class="help card">
          <span class="help-icon"><Icon name="info" size={26} /></span>
          <div class="help-text">
            <strong>{t("docs.help_title")}</strong>
            <span>{t("docs.help_text")}</span>
          </div>
          <a href={lp(lang, "/contacts")} class="btn btn-primary">{t("cta.contact_us")}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .docs-layout { display: grid; grid-template-columns: 260px 1fr; gap: 40px; align-items: start; }
  .docs-side { display: flex; flex-direction: column; gap: 10px; position: sticky; top: 96px; }
  .cat {
    display: flex; align-items: center; gap: 12px; padding: 16px 18px; cursor: pointer;
    font-weight: 700; font-size: 16px; color: var(--navy); background: #fff;
    border: 1px solid var(--border); border-radius: 10px; text-align: left; transition: .16s;
  }
  .cat:hover { border-color: var(--green-500); }
  .cat.active { background: var(--green-500); color: #fff; border-color: var(--green-500); box-shadow: var(--shadow); }

  .docs-panel { display: none; }
  .docs-panel.active { display: block; }
  .docs-panel h1 { font-size: calc(clamp(30px, 4vw, 44px) * var(--ts-hero)); }
  .docs-lead { color: var(--muted); margin: 14px 0 28px; max-width: 640px; }

  .doc-list { display: grid; gap: 14px; }
  .doc-row { display: flex; align-items: center; gap: 18px; padding: 16px 20px; }
  .pdf-badge {
    flex: none; width: 40px; height: 46px; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;
    background: #fdeaea; color: #d8443c; border: 1px solid #f4c9c6; font-size: 11px; font-weight: 800;
  }
  .doc-meta { display: flex; flex-direction: column; gap: 3px; margin-right: auto; }
  .doc-name { font-weight: 700; color: var(--navy); font-size: 16px; }
  .doc-sub { color: var(--muted); font-size: 13px; }
  .doc-dl { flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; font-size: 14px; }

  .help { display: flex; align-items: center; gap: 18px; padding: 22px 26px; margin-top: 32px; background: #f1f8f3; border-color: #d6ebdc; }
  .help-icon { color: var(--green-600); flex: none; }
  .help-text { display: flex; flex-direction: column; gap: 4px; margin-right: auto; }
  .help-text strong { color: var(--navy); font-size: 16px; }
  .help-text span { color: var(--muted); font-size: 14.5px; }

  @media (max-width: 860px) {
    .docs-layout { grid-template-columns: 1fr; }
    .docs-side { position: static; flex-direction: row; flex-wrap: wrap; }
    .cat { flex: 1 1 auto; }
    .help { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  const cats = Array.from(document.querySelectorAll<HTMLElement>("[data-cat]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-catpanel]"));
  cats.forEach((c) =>
    c.addEventListener("click", () => {
      cats.forEach((x) => x.classList.toggle("active", x === c));
      panels.forEach((p) => p.classList.toggle("active", p.dataset.catpanel === c.dataset.cat));
    })
  );
</script>
