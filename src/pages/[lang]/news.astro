---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";
import { NEWS } from "../../data/news";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Новости, отсортированные по дате (новые сверху)
const news = [...NEWS].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const featured = news[0];
const rest = news.slice(1);

const categoryLabel = {
  ru: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
  en: { "Законодательство": "Legislation", "Компания": "Company", "Экспертиза": "Expertise", "События": "Events" },
  ky: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
}[lang];

const formatDate = (iso: string) => {
  const d = new Date(iso);
  const opts: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
  return lang === "ky" ? d.toLocaleDateString("ky-KG", opts) : d.toLocaleDateString(lang === "en" ? "en-US" : "ru-RU", opts);
};
---
<Layout lang={lang} title={t("seo.news.title")} description={t("seo.news.desc")}>
  <section class="page-hero">
    <img class="hero-bg" src="/assets/hero-bg.jpg" alt="" aria-hidden="true" />
    <div class="container">
      <div class="hero-text">
        <h1>{t("page.news_title")}</h1>
        <p>{t("page.news_lead")}</p>
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer">
    <div class="container">
      {/* Featured статья — первая новость в полном формате */}
      {featured && (
        <article class="article-featured reveal" style="--i:0">
          <div class="article-media">
            {featured.image ? (
              <img src={featured.image} alt={featured.title[lang]} class="article-img" loading="lazy" width={900} height={500} />
            ) : (
              <div class="placeholder" style="min-height:360px"><Icon name="newspaper" size={56} /></div>
            )}
          </div>
          <div class="article-body">
            <div class="article-meta">
              <span class="article-category">{categoryLabel[featured.category]}</span>
              <span class="article-date">{formatDate(featured.date)}</span>
            </div>
            <h2 class="article-title">{featured.title[lang]}</h2>
            <p class="article-excerpt">{featured.excerpt[lang]}</p>
            <a href={lp(lang, `/news/${featured.slug}`)} class="btn btn-outline-green">{t("cta.more")} <Icon name="arrow-right" size={18} /></a>
          </div>
        </article>
      )}

      {/* Остальные статьи — сетка */}
      <div class="articles-grid">
        {rest.map((n, i) => (
          <article class="article-card reveal" style={`--i:${i + 1}`}>
            <div class="article-media">
              {n.image ? (
                <img src={n.image} alt={n.title[lang]} class="article-img" loading="lazy" width={500} height={320} />
              ) : (
                <div class="placeholder" style="min-height:200px"><Icon name="newspaper" size={40} /></div>
              )}
            </div>
            <div class="article-body">
              <div class="article-meta">
                <span class="article-category">{categoryLabel[n.category]}</span>
                <span class="article-date">{formatDate(n.date)}</span>
              </div>
              <h3 class="article-title">{n.title[lang]}</h3>
              <p class="article-excerpt">{n.excerpt[lang]}</p>
              <a href={lp(lang, `/news/${n.slug}`)} class="btn btn-outline-green">{t("cta.more")} <Icon name="arrow-right" size={16} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Featured статья */
  .article-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow .28s ease, border-color .28s ease;
  }
  .article-featured:hover {
    box-shadow: var(--shadow);
    border-color: rgba(42,165,74,.35);
  }
  .article-media {
    position: relative;
    height: 100%;
    overflow: hidden;
  }
  .article-img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .5s ease;
  }
  .article-featured:hover .article-img { transform: scale(1.03); }
  .article-body {
    padding: 40px 48px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .article-meta { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
  .article-category {
    background: #e5f4ea; color: var(--green-700); font-size: 12px; font-weight: 700;
    padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .05em;
  }
  .article-date { color: var(--muted); font-size: 13px; }
  .article-title { margin: 0 0 16px; font-size: calc(26px * var(--ts-heading)); line-height: 1.3; }
  .article-excerpt { color: var(--ink); font-size: 16px; line-height: 1.7; margin-bottom: 24px; flex: 1; }
  .article-featured .btn { width: auto; padding: 12px 24px; }

  /* Сетка статей */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .article-card {
    display: flex; flex-direction: column; height: 100%;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow .28s ease, border-color .28s ease, translate .22s ease;
  }
  .article-card:hover {
    translate: 0 -6px;
    box-shadow: var(--shadow);
    border-color: rgba(42,165,74,.35);
  }
  .article-card .article-media {
    height: 210px; overflow: hidden; background: var(--bg);
  }
  .article-card .article-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .article-card .article-body {
    padding: 24px; display: flex; flex-direction: column; flex: 1;
  }
  .article-card .article-title { margin: 0 0 10px; font-size: calc(19px * var(--ts-heading)); line-height: 1.35; }
  .article-card .article-excerpt { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin-bottom: 18px; flex: 1; }
  .article-card .btn { width: 100%; justify-content: center; padding: 10px 16px; font-size: 14px; }

  /* Адаптив */
  @media (max-width: 992px) {
    .article-featured { grid-template-columns: 1fr; }
    .article-featured .article-media { height: 320px; }
    .articles-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }
  @media (max-width: 640px) {
    .articles-grid { grid-template-columns: 1fr; gap: 20px; }
    .article-body { padding: 28px 24px; }
  }
</style>
