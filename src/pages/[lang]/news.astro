---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";
import { api, asset } from "../../lib/api";
import { NEWS } from "../../data/news";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Новости из MySQL (через /api.php), с фолбэком на локальный список
type DbNews = {
  id?: number; slug: string; news_date?: string | null; category?: string | null;
  title: string; excerpt?: string | null; content?: string | null; image?: string | null;
};
const dbNews = await api<DbNews[]>("news", { lang });

// Локальный фолбэк (на случай недоступного API при сборке)
const localNews = [...NEWS].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const news = dbNews.length
  ? dbNews.map((n) => ({
      slug: n.slug,
      date: n.news_date || "",
      category: n.category || "",
      title: n.title,
      excerpt: n.excerpt || "",
      content: n.content || "",
      image: asset(n.image) ?? null,
      fromDb: true,
    }))
  : localNews.map((n) => ({
      slug: n.slug,
      date: n.date,
      category: n.category,
      title: n.title[lang] ?? n.title.ru,
      excerpt: n.excerpt[lang] ?? n.excerpt.ru,
      content: n.content[lang] ?? n.content.ru,
      image: n.image ?? null,
      fromDb: false,
    }));

const categoryLabel = {
  ru: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
  en: { "Законодательство": "Legislation", "Компания": "Company", "Экспертиза": "Expertise", "События": "Events" },
  ky: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
}[lang];

const formatDate = (iso: string) => {
  const d = new Date(iso);
  const opts: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
  return lang === "ky" ? d.toLocaleDateString("ky-KG", opts) : d.toLocaleDateString(lang === "en" ? "en-US" : "ru-RU", opts);
};
---
<Layout lang={lang} title={t("seo.news.title")} description={t("seo.news.desc")} livePage={"news"}>
  <section class="page-hero">
    <img class="hero-bg" src="/assets/hero-bg.jpg" alt="" aria-hidden="true" data-live-hero="hero_image" data-c-img="news.hero.image" />
    <div class="container">
      <div class="hero-text">
        <h1 data-c="global.page.news_title">{t("page.news_title")}</h1>
        <p data-c="global.page.news_lead">{t("page.news_lead")}</p>
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer">
    <div class="container">
      <div class="news-list" data-live-type="news" data-live-template="#tpl-news">
      <template id="tpl-news">
        <article class="article-item reveal" style="--i:1" data-live-key="">
          <div class="article-media" data-live-image>
            <img src="" alt="" class="article-img" loading="lazy" width="900" height="500" data-live-logo hidden />
          </div>
          <div class="article-body">
            <div class="article-meta">
              <span class="article-category" data-live-category></span>
              <span class="article-date" data-live-date></span>
            </div>
            <h2 class="article-title" data-live-name></h2>
            <p class="article-excerpt" data-live-desc></p>
            <a href="#" class="btn btn-outline-green" data-live-url data-c="global.cta.more"></a>
          </div>
        </article>
      </template>
      {news.map((n, i) => (
        <article class="article-item reveal" style={`--i:${i}`} data-live-key={n.slug}>
          <div class="article-media" data-live-image>
            {n.image ? (
              <img src={n.image} alt="" class="article-img" loading="lazy" width={900} height={500} data-live-logo />
            ) : (
              <div class="placeholder" style="min-height:320px"><Icon name="newspaper" size={56} /></div>
            )}
          </div>
          <div class="article-body">
            <div class="article-meta">
              <span class="article-category" data-live-category>{categoryLabel[n.category] ?? n.category}</span>
              <span class="article-date" data-live-date>{n.date ? formatDate(n.date) : ""}</span>
            </div>
            <h2 class="article-title" data-live-name>{n.title}</h2>
            <p class="article-excerpt" data-live-desc>{n.excerpt}</p>
            <a href={lp(lang, `/news/${n.slug}`)} class="btn btn-outline-green" data-live-url data-c="global.cta.more">{t("cta.more")} <Icon name="arrow-right" size={18} /></a>
          </div>
        </article>
      ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Все новости — в формате статьи: изображение слева, текст справа */
  .article-item {
    display: grid;
    grid-template-columns: 420px 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow .28s ease, border-color .28s ease;
  }
  .article-item + .article-item { margin-top: 28px; }
  .article-item:hover {
    box-shadow: var(--shadow);
    border-color: rgba(42,165,74,.35);
  }
  .article-media {
    position: relative;
    min-height: 300px;
    overflow: hidden;
    background: var(--bg);
  }
  .article-img {
    width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0;
    transition: transform .5s ease;
  }
  .article-item:hover .article-img { transform: scale(1.03); }
  .article-body {
    padding: 36px 42px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .article-meta { display: flex; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; align-items: center; }
  .article-category {
    background: #e5f4ea; color: var(--green-700); font-size: 12px; font-weight: 700;
    padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .05em;
  }
  .article-date { color: var(--muted); font-size: 13px; }
  .article-title { margin: 0 0 14px; font-size: calc(26px * var(--ts-heading)); line-height: 1.3; }
  .article-excerpt { color: var(--ink); font-size: 16px; line-height: 1.7; margin-bottom: 22px; flex: 1; }
  .article-item .btn { width: auto; padding: 12px 24px; align-self: flex-start; }

  @media (max-width: 900px) {
    .article-item { grid-template-columns: 1fr; }
    .article-media { min-height: 240px; height: 240px; }
    .article-body { padding: 28px 24px; }
    .article-title { font-size: calc(22px * var(--ts-heading)); }
  }
</style>

