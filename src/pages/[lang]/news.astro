---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";
import { NEWS } from "../../data/news";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Новости, отсортированные по дате (новые сверху)
const news = [...NEWS].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categoryLabel = {
  ru: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
  en: { "Законодательство": "Legislation", "Компания": "Company", "Экспертиза": "Expertise", "События": "Events" },
  ky: { "Законодательство": "Законодательство", "Компания": "Компания", "Экспертиза": "Экспертиза", "События": "События" },
}[lang];

const formatDate = (iso: string) => {
  const d = new Date(iso);
  const opts: Intl.DateTimeFormatOptions = { year: "numeric", month: "long", day: "numeric" };
  return lang === "ky" ? d.toLocaleDateString("ky-KG", opts) : d.toLocaleDateString(lang === "en" ? "en-US" : "ru-RU", opts);
};
---
<Layout lang={lang} title={t("seo.news.title")} description={t("seo.news.desc")}>
  <section class="page-hero">
    <img class="hero-bg" src="/assets/hero-bg.jpg" alt="" aria-hidden="true" />
    <div class="container">
      <div class="hero-text">
        <h1>{t("page.news_title")}</h1>
        <p>{t("page.news_lead")}</p>
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer">
    <div class="container">
      {news.map((n, i) => (
        <article class="article-item reveal" style={`--i:${i}`}>
          <div class="article-media">
            {n.image ? (
              <img src={n.image} alt="" class="article-img" loading="lazy" width={900} height={500} />
            ) : (
              <div class="placeholder" style="min-height:320px"><Icon name="newspaper" size={56} /></div>
            )}
          </div>
          <div class="article-body">
            <div class="article-meta">
              <span class="article-category">{categoryLabel[n.category]}</span>
              <span class="article-date">{formatDate(n.date)}</span>
            </div>
            <h2 class="article-title">{n.title[lang]}</h2>
            <p class="article-excerpt">{n.excerpt[lang]}</p>
            <a href={lp(lang, `/news/${n.slug}`)} class="btn btn-outline-green">{t("cta.more")} <Icon name="arrow-right" size={18} /></a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Все новости — в формате статьи: изображение слева, текст справа */
  .article-item {
    display: grid;
    grid-template-columns: 420px 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: box-shadow .28s ease, border-color .28s ease;
  }
  .article-item + .article-item { margin-top: 28px; }
  .article-item:hover {
    box-shadow: var(--shadow);
    border-color: rgba(42,165,74,.35);
  }
  .article-media {
    position: relative;
    min-height: 300px;
    overflow: hidden;
    background: var(--bg);
  }
  .article-img {
    width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0;
    transition: transform .5s ease;
  }
  .article-item:hover .article-img { transform: scale(1.03); }
  .article-body {
    padding: 36px 42px;
    display: flex; flex-direction: column; justify-content: center;
  }
  .article-meta { display: flex; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; align-items: center; }
  .article-category {
    background: #e5f4ea; color: var(--green-700); font-size: 12px; font-weight: 700;
    padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: .05em;
  }
  .article-date { color: var(--muted); font-size: 13px; }
  .article-title { margin: 0 0 14px; font-size: calc(26px * var(--ts-heading)); line-height: 1.3; }
  .article-excerpt { color: var(--ink); font-size: 16px; line-height: 1.7; margin-bottom: 22px; flex: 1; }
  .article-item .btn { width: auto; padding: 12px 24px; align-self: flex-start; }

  @media (max-width: 900px) {
    .article-item { grid-template-columns: 1fr; }
    .article-media { min-height: 240px; height: 240px; }
    .article-body { padding: 28px 24px; }
    .article-title { font-size: calc(22px * var(--ts-heading)); }
  }
</style>
