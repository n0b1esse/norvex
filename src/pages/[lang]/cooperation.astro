---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const tr = await getT(lang!);

// Локальный контент — site works without CMS
const content = lang === "en" ? [
  { id: "consulting", icon: "clipboard", image: "/assets/cooperation-consulting.webp", label: "Consulting", desc: "A one-time expert assessment of the current state of safety with specific recommendations. We will conduct an audit, identify risks, and propose a step-by-step action plan.", points: ["Comprehensive audit of OHS, industrial safety and environmental protection", "Identification and assessment of occupational risks", "Development of a corrective action plan", "Preparation of a final report for the client"] },
  { id: "outsourcing", icon: "building", image: "/assets/cooperation-outsourcing.webp", label: "Outsourcing", desc: "Full transfer of HSE functions to NORVEX: specialist, documentation, reporting.", points: ["Dedicated HSE specialist on site", "Development and maintenance of documentation", "Regular reports and audits", "Full legal compliance"] },
  { id: "outstaffing", icon: "users", image: "/assets/cooperation-outstaffing.webp", label: "Outstaffing", desc: "Provision of qualified HSE specialists for your projects with full support.", points: ["Certified experts in OSH and IL", "Flexible staffing terms", "Fast start within days", "Quality control and reporting"] },
] : lang === "ky" ? [
  { id: "consulting", icon: "clipboard", image: "/assets/cooperation-consulting.webp", label: "Консалтинг", desc: "Коопсуздук жаатындагы учурдагы абалдын бир жолку эксперттик баасы жана конкреттүү сунуштар менен. Биз аудит жүргүзүп, тобокелдиктерди аныктап, кадам кадам боюнча аракет планын сунуштайбыз.", points: ["ОТ, ПБ жана ООС боюнча комплекстүү аудит", "Кесиптик тобокелдиктерди аныктоо жана баалоо", "Оңдоо иш-чаралары планын иштеп чыгуу", "Кардар үчүн жыйынтык отчетту даярдоо"] },
  { id: "outsourcing", icon: "building", image: "/assets/cooperation-outsourcing.webp", label: "Аутсорсинг", desc: "HSE функцияларын NORVEXке толук өткөрүп берүү: адис, документация, отчеттоо.", points: ["Объекттеги дайын HSE адиси", "Документацияны иштеп чыгуу жана колдоо", "Мезгилдүү отчеттор жана аудиттер", "Мыйзамга толук шайкештик"] },
  { id: "outstaffing", icon: "users", image: "/assets/cooperation-outstaffing.webp", label: "Аутстаффинг", desc: "Долбоорлоруңузга квалификациялуу HSE адистерин берүү жана толук колдоо.", points: ["Сертификатталган эмгек коопсуздугу адистери", "Ийкемдүү шарттар", "3–5 күн ичинде баштоо", "Сапатты текшерүү жана отчеттоо"] },
] : [
  { id: "consulting", icon: "clipboard", image: "/assets/cooperation-consulting.webp", label: "Консалтинг", desc: "Разовая экспертная оценка текущего состояния в области безопасности с выдачей конкретных рекомендаций. Мы проведем аудит, выявим риски и предложим пошаговый план действий.", points: ["Комплексный аудит по ОТ, ПБ и ООС", "Выявление и оценка профессиональных рисков", "Разработка корректирующего плана мероприятий", "Подготовка итоговой отчетности для заказчика"] },
  { id: "outsourcing", icon: "building", image: "/assets/cooperation-outsourcing.webp", label: "Аутсорсинг", desc: "Полная передача функций HSE специалистам NORVEX: адис на объекте, документация, отчётность.", points: ["Выделенный специалист на объекте", "Разработка и ведение документации", "Регулярная отчётность и аудиты", "Полное соответствие законодательству"] },
  { id: "outstaffing", icon: "users", image: "/assets/cooperation-outstaffing.webp", label: "Аутстаффинг", desc: "Предоставление квалифицированных HSE-специалистов для ваших проектов с полной поддержкой.", points: ["Сертифицированные эксперты по охране труда", "Гибкие условия сотрудничества", "Быстрый старт за 3–5 дней", "Контроль качества и отчётность"] },
];
const tabs = content;
---
<Layout lang={lang} title={tr("seo.cooperation.title")} description={tr("seo.cooperation.desc")}>
  <section class="section">
    <div class="container">
      <div class="section-head left">
        <h1 class="section-title">{tr("page.cooperation_title")}</h1>
        <p class="section-lead">{tr("page.cooperation_lead")}</p>
      </div>

      <div class="tabs" role="tablist">
        {tabs.map((tab, i) => (
          <button class:list={["tab", { active: i === 0 }]} role="tab" data-tab={tab.id}>
            <Icon name={tab.icon} size={22} /> {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, i) => (
        <div class:list={["panel card", { active: i === 0 }]} data-panel={tab.id} id={tab.id}>
          <div class="panel-text">
            <h2>{tab.label}</h2>
            <p>{tab.desc}</p>
            <ul class="checklist">
              {tab.points.map((p) => (
                <li><span class="check"><Icon name="check" size={16} /></span>{p}</li>
              ))}
            </ul>
            <a href={lp(lang, "/contacts")} class="btn btn-outline-green">{tr("cta.learn_more")}</a>
          </div>
          <img src={tab.image} alt={tab.label} class="panel-img" width={520} height={320} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .tabs { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }
  .tab {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; cursor: pointer;
    font-weight: 700; font-size: 16px; color: var(--navy); background: #fff;
    border: 1px solid var(--border); border-radius: 10px; box-shadow: var(--shadow-sm); transition: .16s;
  }
  .tab:hover { border-color: var(--green-500); }
  .tab.active { background: var(--green-500); color: #fff; border-color: var(--green-500); }

  .panel { display: none; grid-template-columns: 1fr 1fr; gap: 40px; padding: 40px; align-items: center; scroll-margin-top: 100px; }
  .panel.active { display: grid; }
  .panel-text h2 { font-size: calc(28px * var(--ts-heading)); margin-bottom: 16px; }
  .panel-text p { color: var(--ink); font-size: 16px; }
  .checklist { margin: 24px 0 30px; display: grid; gap: 16px; }
  .checklist li { display: flex; align-items: center; gap: 14px; font-weight: 600; color: var(--navy); }
  .check { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(42,165,74,.14); color: var(--green-600); flex: none; }
  .panel-img { min-height: 320px; border-radius: var(--radius); object-fit: cover; width: 100%; height: 100%; min-height: 320px; }

  @media (max-width: 900px) {
    .panel { grid-template-columns: 1fr; }
    .panel-img { order: -1; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLElement>("[data-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
  function activate(id: string) {
    tabs.forEach((t) => t.classList.toggle("active", t.dataset.tab === id));
    panels.forEach((p) => p.classList.toggle("active", p.dataset.panel === id));
  }
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));
  const hash = location.hash.replace("#", "");
  if (hash && panels.some((p) => p.dataset.panel === hash)) activate(hash);
</script>
