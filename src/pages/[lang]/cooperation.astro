---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const tr = await getT(lang!);

// Локальный контент — original CMS copy (handoff dump), no CMS dependency
const content = lang === "en" ? [
  { id: "consulting", icon: "clipboard", image: "/assets/cooperation-consulting.webp", label: "Consulting", desc: "We provide professional expert support in occupational health and safety, industrial safety, environmental protection and risk management to improve organizational performance and ensure compliance with established requirements.", points: ["Assessment of the current state of processes and management systems", "Hazard identification and risk assessment", "Development of recommendations and improvement plans", "Preparation for audits, inspections and reviews", "Documentation development and methodological support", "Training and development of staff competencies"] },
  { id: "outsourcing", icon: "building", image: "/assets/cooperation-outsourcing.webp", label: "Outsourcing", desc: "Professional performance of occupational health and safety, industrial safety and environmental protection functions at the enterprise, in compliance with legal requirements and industry best practices.", points: ["Full support of OHS, industrial and environmental safety functions", "Maintenance and updating of documentation", "Organization of production control", "Monitoring of compliance with requirements", "Preparation of reporting and analytics", "Support during reviews, inspections and audits"] },
  { id: "outstaffing", icon: "users", image: "/assets/cooperation-outstaffing.webp", label: "Outstaffing", desc: "We provide qualified specialists to reinforce the client's team and deliver projects of various scale and complexity.", points: ["Selection of specialized professionals", "Prompt closing of staffing needs", "Short- and long-term staff engagement", "Support for large projects and contract work", "Replacement of temporarily absent specialists", "Administrative support of personnel"] },
] : lang === "ky" ? [
  { id: "consulting", icon: "clipboard", image: "/assets/cooperation-consulting.webp", label: "Консалтинг", desc: "Уюмдардын ишинин натыйжалуулугун жогорулатуу жана белгиленген талаптарга шайкештигин камсыздоо үчүн эмгекти коргоо, өнөр жай коопсуздугу, айлана-чөйрөнү коргоо жана тобокелдиктерди башкаруу тармагында кесипкөй эксперттик колдоо көрсөтөбүз.", points: ["Процесстердин жана башкаруу системаларынын учурдагы абалын баалоо", "Коркунучтарды аныктоо жана тобокелдиктерди баалоо", "Сунуштарды жана жакшыртуу пландарын иштеп чыгуу", "Аудиттерге, инспекцияларга жана текшерүүлөргө даярдоо", "Документтерди иштеп чыгуу жана методологиялык колдоо", "Персоналдын компетенцияларын окутуу жана өнүктүрүү"] },
  { id: "outsourcing", icon: "building", image: "/assets/cooperation-outsourcing.webp", label: "Аутсорсинг", desc: "Ишканада мыйзам талаптарына жана тармактын мыкты тажрыйбаларына ылайык эмгекти коргоо, өнөр жай коопсуздугу жана айлана-чөйрөнү коргоо функцияларын кесипкөй аткаруу.", points: ["Эмгекти коргоо, өнөр жай жана айлана-чөйрө коопсуздугу функцияларын толук коштоо", "Документтерди жүргүзүү жана жаңылоо", "Өндүрүштүк контролду уюштуруу", "Талаптардын сакталышын мониторинг кылуу", "Отчёттуулукту жана аналитиканы даярдоо", "Текшерүүлөрдү, инспекцияларды жана аудиттерди коштоо"] },
  { id: "outstaffing", icon: "users", image: "/assets/cooperation-outstaffing.webp", label: "Аутстаффинг", desc: "Кардардын командасын күчөтүү жана ар кандай масштабдагы жана татаалдыктагы долбоорлорду ишке ашыруу үчүн квалификациялуу адистерди беребиз.", points: ["Тармактык адистерди тандоо", "Кадрдык муктаждыкты тез жабуу", "Кыска жана узак мөөнөттүү персоналды тартуу", "Ири долбоорлорду жана подряддык иштерди колдоо", "Убактылуу жок адистерди алмаштыруу", "Персоналды административдик коштоо"] },
] : [
  { id: "consulting", icon: "clipboard", image: "/assets/cooperation-consulting.webp", label: "Консалтинг", desc: "Предоставляем профессиональную экспертную поддержку в области охраны труда, промышленной безопасности, охраны окружающей среды и управления рисками для повышения эффективности деятельности организаций и обеспечения соответствия установленным требованиям.", points: ["Оценка текущего состояния процессов и систем управления", "Идентификация опасностей и оценка рисков", "Разработка рекомендаций и планов улучшения", "Подготовка к аудитам, инспекциям и проверкам", "Разработка документации и методологическая поддержка", "Обучение и развитие компетенций персонала"] },
  { id: "outsourcing", icon: "building", image: "/assets/cooperation-outsourcing.webp", label: "Аутсорсинг", desc: "Профессиональное выполнение функций охраны труда, промышленной безопасности и охраны окружающей среды в соответствии с требованиями законодательства и лучшими отраслевыми практиками на предприятии.", points: ["Полное сопровождение функций ОТ, ПБ и ООС", "Ведение и актуализация документации", "Организация производственного контроля", "Мониторинг соблюдения требований", "Подготовка отчетности и аналитики", "Сопровождение проверок, инспекций и аудитов"] },
  { id: "outstaffing", icon: "users", image: "/assets/cooperation-outstaffing.webp", label: "Аутстаффинг", desc: "Предоставляем квалифицированных специалистов для усиления команды Заказчика и реализации проектов различного масштаба и сложности.", points: ["Подбор профильных специалистов", "Оперативное закрытие кадровой потребности", "Краткосрочное и долгосрочное привлечение персонала", "Поддержка крупных проектов и подрядных работ", "Замещение временно отсутствующих специалистов", "Административное сопровождение персонала"] },
];
const tabs = content;
---
<Layout lang={lang} title={tr("seo.cooperation.title")} description={tr("seo.cooperation.desc")}>
  <section class="section">
    <div class="container">
      <div class="section-head left">
        <h1 class="section-title">{tr("page.cooperation_title")}</h1>
        <p class="section-lead">{tr("page.cooperation_lead")}</p>
      </div>

      <div class="tabs" role="tablist">
        {tabs.map((tab, i) => (
          <button class:list={["tab", { active: i === 0 }]} role="tab" data-tab={tab.id}>
            <Icon name={tab.icon} size={22} /> {tab.label}
          </button>
        ))}
      </div>

      {tabs.map((tab, i) => (
        <div class:list={["panel card", { active: i === 0 }]} data-panel={tab.id} id={tab.id}>
          <div class="panel-text">
            <h2>{tab.label}</h2>
            <p>{tab.desc}</p>
            <ul class="checklist">
              {tab.points.map((p) => (
                <li><span class="check"><Icon name="check" size={16} /></span>{p}</li>
              ))}
            </ul>
            <a href={lp(lang, "/contacts")} class="btn btn-outline-green">{tr("cta.learn_more")}</a>
          </div>
          <img src={tab.image} alt={tab.label} class="panel-img" width={520} height={320} />
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .tabs { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 28px; }
  .tab {
    display: inline-flex; align-items: center; gap: 10px; padding: 16px 26px; cursor: pointer;
    font-weight: 700; font-size: 16px; color: var(--navy); background: #fff;
    border: 1px solid var(--border); border-radius: 10px; box-shadow: var(--shadow-sm); transition: .16s;
  }
  .tab:hover { border-color: var(--green-500); }
  .tab.active { background: var(--green-500); color: #fff; border-color: var(--green-500); }

  .panel { display: none; grid-template-columns: 1fr 1fr; gap: 40px; padding: 40px; align-items: center; scroll-margin-top: 100px; }
  .panel.active { display: grid; }
  .panel-text h2 { font-size: calc(28px * var(--ts-heading)); margin-bottom: 16px; }
  .panel-text p { color: var(--ink); font-size: 16px; }
  .checklist { margin: 24px 0 30px; display: grid; gap: 16px; }
  .checklist li { display: flex; align-items: center; gap: 14px; font-weight: 600; color: var(--navy); }
  .check { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(42,165,74,.14); color: var(--green-600); flex: none; }
  .panel-img { min-height: 320px; border-radius: var(--radius); object-fit: cover; width: 100%; height: 100%; min-height: 320px; }

  @media (max-width: 900px) {
    .panel { grid-template-columns: 1fr; }
    .panel-img { order: -1; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLElement>("[data-tab]"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-panel]"));
  function activate(id: string) {
    tabs.forEach((t) => t.classList.toggle("active", t.dataset.tab === id));
    panels.forEach((p) => p.classList.toggle("active", p.dataset.panel === id));
  }
  tabs.forEach((t) => t.addEventListener("click", () => activate(t.dataset.tab!)));
  const hash = location.hash.replace("#", "");
  if (hash && panels.some((p) => p.dataset.panel === hash)) activate(hash);
</script>
