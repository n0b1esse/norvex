---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getT, lp, localeStaticPaths } from "../../i18n";

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.params;
const t = await getT(lang!);

// Локальный контент услуг — оригинальные тексты из CMS (дамп handoff).
const services = lang === "en" ? [
  { slug: "consulting", icon: "clipboard", title: "Consulting in occupational, industrial and environmental safety", description: "Expert support in ensuring safety, managing risks and meeting legal requirements." },
  { slug: "outsourcing", icon: "building", title: "Outsourcing of occupational, industrial and environmental safety functions", description: "End-to-end performance of OHS, industrial and environmental safety functions with control, reporting and ongoing support of the organization's operations." },
  { slug: "outstaffing", icon: "users", title: "Specialist outstaffing", description: "Provision of qualified specialists for short- or long-term reinforcement of the client's team in line with project requirements." },
  { slug: "audits", icon: "search", title: "Audits and inspections", description: "Independent assessment of compliance with legal requirements, corporate standards and industry best practices." },
  { slug: "docs", icon: "file-text", title: "Documentation development", description: "Development and updating of OHS, industrial and environmental safety documentation in compliance with legal requirements and international standards." },
  { slug: "contractors", icon: "settings", title: "Contractor management", description: "Assessment, support and monitoring of contractor organizations to ensure safety, quality and compliance with established requirements." },
] : lang === "ky" ? [
  { slug: "consulting", icon: "clipboard", title: "Эмгекти коргоо, өнөр жай жана айлана-чөйрө коопсуздугу боюнча консалтинг", description: "Коопсуздукту камсыздоо, тобокелдиктерди башкаруу жана мыйзам талаптарына шайкештик маселелеринде эксперттик колдоо." },
  { slug: "outsourcing", icon: "building", title: "Эмгекти коргоо, өнөр жай жана айлана-чөйрө коопсуздугу функцияларын аутсорсинг", description: "Эмгекти коргоо, өнөр жай жана айлана-чөйрө коопсуздугу функцияларын контролдоо, отчёттуулук жана уюмдун ишин туруктуу коштоо менен комплекстүү аткаруу." },
  { slug: "outstaffing", icon: "users", title: "Адистерди аутстаффинг", description: "Долбоордун талаптарына ылайык кардардын командасын убактылуу же узак мөөнөттүү күчөтүү үчүн тармактык адистерди берүү." },
  { slug: "audits", icon: "search", title: "Аудиттер жана текшерүүлөр", description: "Мыйзам талаптарына, корпоративдик стандарттарга жана тармактын мыкты тажрыйбаларына шайкештигин көз карандысыз баалоо." },
  { slug: "docs", icon: "file-text", title: "Документтерди иштеп чыгуу", description: "Мыйзам талаптарына жана эл аралык стандарттарга ылайык эмгекти коргоо, өнөр жай жана айлана-чөйрө коопсуздугу боюнча документтерди иштеп чыгуу жана жаңылоо." },
  { slug: "contractors", icon: "settings", title: "Подрядчыларды башкаруу", description: "Коопсуздукту, сапатты жана белгиленген талаптарды сактоону камсыздоо үчүн подряд уюмдарын баалоо, коштоо жана контролдоо." },
] : [
  { slug: "consulting", icon: "clipboard", title: "Консалтинг в области ОТ, ПБ и ООС", description: "Экспертная поддержка в вопросах обеспечения безопасности, управления рисками и соответствия требованиям законодательства." },
  { slug: "outsourcing", icon: "building", title: "Аутсорсинг функций ОТ, ПБ и ООС", description: "Комплексное выполнение функций ОТ, ПБ и ООС с обеспечением контроля, отчетности и постоянного сопровождения деятельности организации." },
  { slug: "outstaffing", icon: "users", title: "Аутстаффинг специалистов", description: "Предоставление профильных специалистов для временного или долгосрочного усиления команды заказчика в соответствии с требованиями проекта." },
  { slug: "audits", icon: "search", title: "Аудиты и инспекции", description: "Независимая оценка соответствия требованиям законодательства, корпоративных стандартов и лучших отраслевых практик." },
  { slug: "docs", icon: "file-text", title: "Разработка документации", description: "Разработка и актуализация документации в области ОТ, ПБ и ООС в соответствии с требованиями законодательства и международных стандартов." },
  { slug: "contractors", icon: "settings", title: "Управление подрядчиками", description: "Оценка, сопровождение и контроль подрядных организаций для обеспечения безопасности, качества и соблюдения установленных требований." },
];
---
<Layout lang={lang} title={t("seo.services.title")} description={t("seo.services.desc")}>
  <section class="page-hero">
    <img class="hero-bg" src="/newOffice.png" alt="" aria-hidden="true" />
    <div class="container">
      <div class="hero-text">
        <h1>{t("page.services_title")}</h1>
        <p>{t("page.services_lead")}</p>
      </div>
    </div>
  </section>

  <section class="section bg-soft fill-to-footer">
    <div class="container">
      <div class="grid grid-3">
        {services.map((s, i) => (
          <article id={s.slug} class="card service reveal" style={`--i:${i}`}>
            <span class="icon-badge"><Icon name={s.icon} size={36} /></span>
            <h3>{s.title}</h3>
            <p>{s.description}</p>
            <a href={lp(lang, "/contacts")} class="more">{t("cta.more")} <Icon name="arrow-right" size={18} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .service { position: relative; overflow: hidden; padding: 34px 30px; display: flex; flex-direction: column; align-items: center; text-align: center; scroll-margin-top: 100px; }
  .service::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--green-500);
    transform: scaleX(0); transform-origin: left; transition: transform .28s ease;
  }
  .service:hover::before { transform: scaleX(1); }
  .service h3 { margin: 20px 0 12px; font-size: calc(21px * var(--ts-heading)); }
  .service p { color: var(--muted); font-size: 15.5px; }
  .service .more { margin-top: 22px; display: inline-flex; align-items: center; gap: 8px; color: var(--green-600); font-weight: 700; font-size: 15px; }
  .service .more svg { transition: transform .2s ease; }
  .service .more:hover { gap: 12px; }
  .service:hover .more svg { transform: translateX(3px); }
</style>
