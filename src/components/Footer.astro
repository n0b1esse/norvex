---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { getT, lp, type Locale } from "../i18n";
const { lang } = Astro.props as { lang: Locale };
const t = await getT(lang);
const year = new Date().getFullYear();

const menu = [
  ["nav.home", "/"], ["nav.about", "/about"], ["nav.services", "/services"],
  ["nav.team", "/team"], ["nav.news", "/news"], ["nav.contacts", "/contacts"],
].map(([k, p]) => [t(k), lp(lang, p === "/" ? "" : p)]);

const servicesLinks = lang === "en" ? [
  ["HSE consulting", lp(lang, "/services")],
  ["HSE outsourcing", lp(lang, "/services")],
  ["Outstaffing", lp(lang, "/services")],
  ["Audits and inspections", lp(lang, "/services#audits")],
  ["Documentation development", lp(lang, "/services#docs")],
  ["Contractor management", lp(lang, "/services#contractors")],
] : [
  ["Консалтинг в области HSE", lp(lang, "/services")],
  ["Аутсорсинг функций HSE", lp(lang, "/services")],
  ["Аутстаффинг специалистов", lp(lang, "/services")],
  ["Аудиты и инспекции", lp(lang, "/services#audits")],
  ["Разработка документации", lp(lang, "/services#docs")],
  ["Управление подрядчиками", lp(lang, "/services#contractors")],
];

const docsLinks = lang === "en" ? ["Policies", "Procedures", "Checklists"] : lang === "ky" ? ["Саясаттар", "Процедуралар", "Чек-листтер"] : ["Политики", "Процедуры", "Чек-листы"];

const tagline = lang === "en" ? "Responsibility. Safety. Results." : lang === "ky" ? "Жоопкерчилик. Коопсуздук. Натыйжа." : "Ответственность. Безопасность. Результат.";

const socials = [
  { icon: "whatsapp", cls: "wa", label: "WhatsApp", href: "https://wa.me/996550209209" },
  { icon: "telegram", cls: "tg", label: "Telegram", href: "https://t.me/NORVEX_HSE" },
  { icon: "linkedin", cls: "li", label: "LinkedIn", href: "https://www.linkedin.com/company/norvex-hse" },
  { icon: "instagram", cls: "ig", label: "Instagram", href: "https://www.instagram.com/norvex.hse" },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo variant="light" height={90} href={lp(lang)} footer />
        <p set:text={tagline}></p>
        {socials.length > 0 && (
          <div class="socials">
            {socials.map((s) => (
              <a href={s.href} aria-label={s.label} class={`soc ${s.cls}`} target="_blank" rel="noopener noreferrer"><Icon name={s.icon} size={20} /></a>
            ))}
          </div>
        )}
      </div>

      <div class="footer-col">
        <h4 data-c="global.footer.menu">{t("footer.menu")}</h4>
        <ul>{menu.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
      </div>

      <div class="footer-col">
        <h4 data-c="global.footer.services">{t("footer.services")}</h4>
        <ul>{servicesLinks.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
      </div>

      <div class="footer-col">
        <h4 data-c="global.footer.documents">{t("footer.documents")}</h4>
        <ul>{docsLinks.map((l) => <li><a href={lp(lang, "/documents")}>{l}</a></li>)}</ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span data-c="global.footer.rights">{t("footer.rights", { year })}</span>
      <a href={lp(lang, "/privacy")} data-c="global.footer.privacy">{t("footer.privacy")}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-900); color: rgba(255,255,255,.72); padding-block: 64px 28px; }
  .footer-grid { display: grid; grid-template-columns: 1.5fr 1fr 1.2fr 1.2fr; gap: 32px; }
  .footer-brand p { margin-top: 18px; font-size: 14.5px; line-height: 1.7; }
  .socials { display: flex; gap: 12px; margin-top: 22px; }
  .soc { width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: #fff; }
  .soc.wa { background: #25c366; } .soc.tg { background: #29a9eb; } .soc.li { background: #2f80c4; }
  .soc.ig { background: linear-gradient(45deg, #f09433, #e6683c 30%, #dc2743 50%, #cc2366 70%, #bc1888); }
  .soc:hover { opacity: .88; }
  .footer-col h4 { color: #fff; font-size: 16px; margin-bottom: 20px; }
  .footer-col li { margin-bottom: 13px; }
  .footer-col a { font-size: 14.5px; color: rgba(255,255,255,.72); }
  .footer-col a:hover { color: var(--green-500); }
  .footer-bottom {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.12); font-size: 14px;
  }
  .footer-bottom a { color: rgba(255,255,255,.72); }
  .footer-bottom a:hover { color: var(--green-500); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
