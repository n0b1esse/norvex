---
// Renders a content image when uploaded, else the labelled placeholder.
// Centralises the `{asset(id) ? <img/> : <Placeholder/>}` pattern used across pages.
// Page-specific sizing comes from the passed `class` (e.g. .hero-img); the shared
// `.cms-img` base (in global.css) gives width/object-fit/border-radius.
import Placeholder from "./Placeholder.astro";
import { asset } from "../lib/api";
interface Props { id?: string | null; label: string; alt?: string; class?: string; dark?: boolean; width?: number; height?: number; }
const { id, label, alt, class: cls = "", dark = false, width, height } = Astro.props;
const src = asset(id);
---
{src
  ? <img class:list={["cms-img", cls]} src={src} alt={alt ?? label} width={width} height={height} />
  : <Placeholder label={label} dark={dark} class={cls} />}
