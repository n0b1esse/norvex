---
// Inline SVG icon set (stroke-based, inherits currentColor).
// Renders any of the ~1700 Lucide icons by their kebab-case name (see lucide.dev/icons),
// plus a few brand marks Lucide doesn't ship. Directus `icon` fields store these names;
// an unknown name falls back to `shield`.
import lucideNodes from "lucide-static/icon-nodes.json";

interface Props { name: string; size?: number; class?: string; }
const { name, size = 24, class: cls = "" } = Astro.props;

// Brand/custom icons Lucide doesn't include — raw inner-SVG markup.
const brand: Record<string, string> = {
  whatsapp: '<path d="M4 20l1.3-3.9A7.5 7.5 0 1 1 8 19.1z"/><path d="M9 9.2c.2-.6.4-.6.7-.6h.5c.2 0 .4 0 .6.5l.6 1.4c.1.2 0 .4-.1.5l-.4.5c-.1.2-.2.3 0 .6a6 6 0 0 0 2.3 2c.3.1.4.1.6-.1l.5-.6c.2-.2.3-.2.5-.1l1.3.7c.2.1.4.2.4.4 0 .4-.2 1.1-.5 1.3-.3.3-1.3.7-2.4.4a8 8 0 0 1-4.9-4.4c-.3-.8-.3-1.6-.1-2z"/>',
  telegram: '<path d="M21 4.5 2.8 11.4c-.7.3-.7 1.2 0 1.4l4.4 1.4 1.7 5c.2.5.8.6 1.1.2l2.4-2.4 4.5 3.3c.5.4 1.2.1 1.3-.5L21.9 5.4c.1-.7-.5-1.2-.9-.9z"/><path d="M7.2 13.8 16 7.5l-6.6 7.2"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><line x1="7" y1="10" x2="7" y2="17"/><circle cx="7" cy="6.8" r="1.1" fill="currentColor" stroke="none"/><path d="M11 17v-4a2.5 2.5 0 0 1 5 0v4M11 10.5V17"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1.1" fill="currentColor" stroke="none"/>',
};

// Aliases → canonical Lucide names (covers names seeded before the Lucide switch).
const aliases: Record<string, string> = { scales: "scale", refresh: "refresh-cw" };

type Node = [string, Record<string, string | number>];
const nodes = lucideNodes as Record<string, Node[]>;
const toSvg = (ns: Node[]) =>
  ns.map(([tag, attrs]) =>
    `<${tag} ${Object.entries(attrs).map(([k, v]) => `${k}="${v}"`).join(" ")} />`
  ).join("");

const lucideKey = aliases[name] ?? name;
const inner = brand[name] ?? toSvg(nodes[lucideKey] ?? nodes.shield);
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24"
  fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
  class={cls} set:html={inner} aria-hidden="true"></svg>
