---
// NORVEX logo: local wordmark from public assets, or inline shield fallback.
interface Props { variant?: "dark" | "light"; height?: number; href?: string; footer?: boolean; }
const { variant = "dark", height = 38, href = "/", footer = false } = Astro.props;
const mainColor = variant === "light" ? "#ffffff" : "var(--navy)";
---
<a href={href} class="logo" aria-label="NORVEX — на главную" style={`--logo-h:${height}px; --logo-main:${mainColor};`}>
  <img class="logo-mark" src={variant === "light" ? "/assets/logo-white.png" : "/assets/logo-dark.png"} alt="NORVEX" />
</a>

<style>
  /* flex: none so the logo never shrinks in the flex header bar — otherwise the
     width:auto image collapses toward 0 when nav text is wide (RU/KY). */
  .logo { display: inline-flex; align-items: center; flex: none; }
  .logo-mark { height: var(--logo-h); width: auto; flex: none; }
  /* A wide logo-with-text shouldn't crowd the burger on small phones. */
  @media (max-width: 480px) { .logo-mark { height: calc(var(--logo-h) * .82); } }
</style>
