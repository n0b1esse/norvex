---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { favicon } from "../generated/favicon";
import { HTML_LANG, LOCALES, type Locale } from "../i18n";

interface Props { title?: string; description?: string; lang?: Locale; }
const {
  title = "NORVEX — Надежный партнер в области HSE",
  description = "NORVEX — охрана труда, промышленная безопасность и экология: от консалтинга до полного аутсорсинга функций HSE.",
  lang = "ru",
} = Astro.props;

// --- SEO: canonical, hreflang alternates, OG/Twitter, Organization JSON-LD ---
// All absolute URLs resolve against `site` (astro.config → https://norvexhse.com).
const site = Astro.site!;
// Path without the /ru|/en|/ky prefix, so we can swap in each locale for hreflang.
const rest = Astro.url.pathname.replace(/^\/(ru|en|ky)/, "").replace(/\/$/, "");
// Trailing slash to match Astro's emitted URLs + the generated sitemap, so canonical,
// hreflang and sitemap all agree (no near-duplicate URL variants for crawlers).
const altUrl = (loc: string) => new URL(`/${loc}${rest}/`, site).href;
const canonical = altUrl(lang);
const OG_LOCALE: Record<string, string> = { ru: "ru_RU", en: "en_US", ky: "ky_KG" };
const ogImage = new URL("/norvexHero.jpg", site).href;
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "NORVEX",
  url: site.href,
  logo: new URL("/norvexLogo.png", site).href,
  email: "info@norvex-hse.com",
  telephone: "+996 550 209 209",
  sameAs: ["https://www.instagram.com/norvex.hse", "https://www.linkedin.com/company/norvex-hse", "https://t.me/NORVEX_HSE"],
};

const typeScaleStyle = "--ts-hero:1;--ts-heading:1;--ts-body:1";
---
<!doctype html>
<html lang={HTML_LANG[lang]} style={typeScaleStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Mark JS as available before first paint so .reveal elements start hidden
        only for JS users (no-JS visitors get the fully-visible fallback). */}
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link rel="icon" href={favicon.href} type={favicon.type} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    {/* hreflang: tell search engines about the ru/en/ky versions of this page. */}
    {LOCALES.map((loc) => <link rel="alternate" hreflang={loc} href={altUrl(loc)} />)}
    <link rel="alternate" hreflang="x-default" href={altUrl("ru")} />

    {/* Open Graph (Facebook, Telegram, WhatsApp link previews). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NORVEX" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    {/* Twitter / X card. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} is:inline />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Reveal-on-scroll: add .is-visible as each .reveal enters the viewport.
      // Skipped entirely under reduced-motion (CSS keeps everything visible).
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
          });
        }, { threshold: 0.15, rootMargin: "0px 0px -10% 0px" });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
